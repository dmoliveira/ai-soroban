---
import ContinuityNextAction from './ContinuityNextAction.astro';

interface EntrySummary {
  id: string;
  skill: string;
  level: string;
}

interface Props {
  lessons: EntrySummary[];
  exercises: EntrySummary[];
}

const { lessons, exercises } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="panel progress-panel" data-base={base} data-lessons={JSON.stringify(lessons)} data-exercises={JSON.stringify(exercises)}>
  <div class="section-head">
    <div>
      <p class="eyebrow">Progress overview · 歩み</p>
      <h2>Decide the next move first</h2>
      <p class="muted">This page keeps the action path at the top, then shows deeper progress signals only after the next step is clear.</p>
    </div>
  </div>

  <ContinuityNextAction surface="progress" headingLevel="h3" />

  <div class="progress-hero-grid">
    <section class="panel ink-panel">
      <p class="eyebrow">Session path</p>
      <h3 id="journey-title">Begin your first stone</h3>
      <p id="journey-copy" class="muted">Small steps, steady hands.</p>
      <div class="garden-strip" id="garden-strip" aria-label="Progress garden"></div>
    </section>

    <section class="panel ink-panel">
      <p class="eyebrow">Dojo rank</p>
      <h3 id="rank-title">Shoshin · Beginner’s mind</h3>
      <p id="rank-copy" class="muted">Start calmly and let repetition shape confidence.</p>
      <div class="ink-meter">
        <div id="ink-meter-fill" class="ink-meter-fill"></div>
      </div>
      <p id="ink-meter-label" class="muted small">0 / 100 path energy</p>
    </section>
  </div>

  <div class="stats-grid progress-stats-grid">
    <article class="stat-card stat-card-soft"><small>Lessons completed:</small><span id="completed-lessons">0</span></article>
    <article class="stat-card stat-card-soft"><small>Exercises attempted:</small><span id="attempted-exercises">0</span></article>
    <article class="stat-card stat-card-soft"><small>Items to review:</small><span id="review-items">0</span></article>
    <article class="stat-card stat-card-soft"><small>Practice time:</small><span id="time-practiced">0m</span></article>
    <article class="stat-card stat-card-soft"><small>Sessions finished:</small><span id="finished-sessions">0</span></article>
    <article class="stat-card stat-card-soft"><small>Best practice accuracy:</small><span id="best-score">0</span></article>
  </div>

  <details class="panel progress-more disclosure-block">
    <summary>More progress, history, and rewards</summary>
    <div class="progress-more-content">
      <section class="panel ink-panel progress-links-strip">
        <strong>Quick links</strong>
        <div class="button-row button-row-compact">
          <a class="button button-secondary" href={`${base}practice`}>Practice</a>
          <a class="button button-secondary" href={`${base}worksheets`}>Worksheets</a>
          <a class="button button-secondary" href={`${base}study-plan`}>Study plan</a>
          <a class="button button-secondary" href={`${base}lessons`}>Lessons</a>
          <a class="button button-secondary" href={`${base}exercises`}>Exercises</a>
          <a class="button button-secondary" href={`${base}daily-drills`}>Daily drills</a>
        </div>
      </section>

      <div class="progress-hero-grid">
        <section class="panel ink-panel">
          <p class="eyebrow">Milestones</p>
          <div class="milestone-row" id="milestone-row" role="list" aria-label="Learning milestones"></div>
        </section>

        <section class="panel ink-panel">
          <p class="eyebrow">Recent sessions</p>
          <div id="recent-sessions" class="session-list"></div>
        </section>
      </div>

      <section class="panel ink-panel">
        <p class="eyebrow">Skill map</p>
        <h3>First-check evidence by practice area</h3>
        <p class="muted small">Assisted corrections remain useful activity, but only unassisted first checks enter this evidence view.</p>
        <div id="skill-map" class="skill-map"></div>
      </section>

      <section class="panel ink-panel">
        <p class="eyebrow">Worksheet submodes</p>
        <h3>Checked worksheet activity by focus</h3>
        <p class="muted small">These checked results can include later corrections. Unassisted first-check evidence stays separate in the Skill map above.</p>
        <div id="worksheet-focus-map" class="skill-map"></div>
      </section>

      <section class="panel ink-panel">
        <p class="eyebrow">Today’s reflection</p>
        <div class="reflection-grid">
          <div>
            <h3 id="reflection-title">Keep the next step calm</h3>
            <p id="reflection-copy" class="muted">Your progress stays in this browser unless you clear it.</p>
          </div>
          <div class="review-chip-row" id="reflection-chips"></div>
        </div>
      </section>
    </div>
  </details>

  <section class="panel ink-panel progress-reset-panel">
    <p class="eyebrow">Local data</p>
    <div class="route-card-footer">
      <div>
        <strong>Reset progress in this browser</strong>
        <p class="muted small">This clears every saved learning record on this device, including placement, weekly-plan, game, worksheet, practice, and boss progress. Display preferences are preserved.</p>
      </div>
      <button class="button button-secondary" id="reset-progress">Reset progress</button>
    </div>
    <p id="reset-progress-status" class="muted small" role="status" aria-live="polite"></p>
  </section>
</section>

<script>
  // @ts-nocheck
  import { isBossComplete, normalizeBossCompletionRecord } from '../lib/boss-provenance.js';
  import { canonicalizeChallengeSession, isChallengeSessionOpaque } from '../lib/challenges.js';
  import { buildFocusedPracticeHref, buildFocusedWorksheetHref, formatReviewBasis, readReviewProfile, resolveReviewFocus, resolveWorksheetTarget, toBaseHref } from '../lib/learner-continuity.js';
  import { selectQualifiedFirstCheckEvidence } from '../lib/mastery.js';
  import { STORAGE_KEYS, clearProgressStorage, normalizeStoredRecord, readStoredArray, readStoredJson, readStoredRecord } from '../lib/storage.js';
  import { ensureStorageCompatibility } from '../lib/storage-migrations.js';

  const compatibility = ensureStorageCompatibility(localStorage);

  const root = document.querySelector('.progress-panel');
  const base = root?.dataset.base || '/soroban-dojo/';
  const lessonMeta = JSON.parse(root?.dataset.lessons || '[]');
  const exerciseMeta = JSON.parse(root?.dataset.exercises || '[]');

  const lessonData = readStoredArray(localStorage, STORAGE_KEYS.completedLessons);
  const exerciseData = readStoredRecord(localStorage, STORAGE_KEYS.exerciseStates);
  const timerData = readStoredArray(localStorage, STORAGE_KEYS.timerHistory);
  const sessionData = readStoredArray(localStorage, STORAGE_KEYS.practiceSessions)
    .filter((entry) => entry && typeof entry === 'object' && !Array.isArray(entry))
    .map((entry) => {
      if (!Array.isArray(entry.questions) && !isChallengeSessionOpaque(entry)) return null;
      const session = canonicalizeChallengeSession({ ...entry, responses: normalizeStoredRecord(entry.responses) });
      return session ? { ...session, questions: Array.isArray(entry.questions) ? session.questions : [] } : null;
    })
    .filter(Boolean);
  const worksheetData = readStoredArray(localStorage, STORAGE_KEYS.worksheetSessions);
  const bossData = normalizeBossCompletionRecord(readStoredRecord(localStorage, STORAGE_KEYS.bossRounds));
  const evidenceData = readStoredArray(localStorage, STORAGE_KEYS.masteryEvidence);
  const rawSeenEvidenceItems = readStoredJson(localStorage, STORAGE_KEYS.masterySeenItems, null);
  const reviewProfile = readReviewProfile(localStorage, exerciseData);
  const reviewFocus = resolveReviewFocus(reviewProfile);
  const qualifiedEvidence = selectQualifiedFirstCheckEvidence({ evidenceLedger: evidenceData, seenIndex: rawSeenEvidenceItems });
  const evidenceAccuracy = qualifiedEvidence.length
    ? Math.round((qualifiedEvidence.filter(({ summary }) => summary.firstCheckCorrect).length / qualifiedEvidence.length) * 100)
    : 0;

  const attempted = Object.values(exerciseData).filter(Boolean);
  const totalSeconds = timerData.reduce((sum, entry) => sum + (entry?.seconds || ((entry?.minutes || 0) * 60)), 0);
  const totalMinutes = Math.round(totalSeconds / 60);
  const finishedSessions = sessionData.filter((entry) => entry?.completed);
  const scoredSessions = finishedSessions.filter((entry) => !entry.challengeUnavailable);
  const bestScore = scoredSessions.reduce((best, entry) => Math.max(best, entry.finalScore || 0), 0);
  const journeyEnergy = Math.min(100, lessonData.length * 10 + attempted.length * 2 + finishedSessions.length * 6 + Math.floor(totalMinutes / 5));

  const rankBands = [
    { max: 20, title: 'Shoshin · Beginner’s mind', copy: 'Begin calmly and let each repetition become a brush stroke.' },
    { max: 40, title: 'Kaizen · Steady growth', copy: 'Your path is forming through small, honest steps.' },
    { max: 65, title: 'Rei · Disciplined rhythm', copy: 'You are building respectful consistency in the dojo.' },
    { max: 85, title: 'Ma · Calm space', copy: 'Your work shows control, spacing, and steadier confidence.' },
    { max: 100, title: 'Takumi · Refined hands', copy: 'Your sessions now carry a stronger sense of craft.' },
  ];
  const currentRank = rankBands.find((entry) => journeyEnergy <= entry.max) || rankBands[rankBands.length - 1];

  const gardenStrip = document.getElementById('garden-strip');
  const milestoneRow = document.getElementById('milestone-row');
  const recentSessions = document.getElementById('recent-sessions');
  const reflectionChips = document.getElementById('reflection-chips');
   const skillMap = document.getElementById('skill-map');
   const worksheetFocusMount = document.getElementById('worksheet-focus-map');

  document.getElementById('completed-lessons').textContent = String(lessonData.length);
  document.getElementById('attempted-exercises').textContent = String(attempted.length);
  document.getElementById('review-items').textContent = String(reviewProfile.total);
  document.getElementById('time-practiced').textContent = `${totalMinutes}m`;
  document.getElementById('finished-sessions').textContent = String(finishedSessions.length);
  document.getElementById('best-score').textContent = scoredSessions.length ? String(bestScore) : '—';

  document.getElementById('rank-title').textContent = currentRank.title;
  document.getElementById('rank-copy').textContent = currentRank.copy;
  document.getElementById('ink-meter-fill').style.width = `${journeyEnergy}%`;
  document.getElementById('ink-meter-label').textContent = `${journeyEnergy} / 100 path energy`;

  const journeyTitle = lessonData.length ? `You have placed ${lessonData.length} stones on your path` : 'Begin your first stone';
  const journeyCopy = finishedSessions.length
    ? scoredSessions.length
      ? `You have completed ${finishedSessions.length} formal sessions and your best available practice accuracy is ${bestScore}/100.`
      : `You have completed ${finishedSessions.length} formal sessions, but no saved accuracy is available for comparison.`
    : 'Small steps, steady hands.';
  document.getElementById('journey-title').textContent = journeyTitle;
  document.getElementById('journey-copy').textContent = journeyCopy;

  const gardenPieces = [
    ...Array.from({ length: Math.min(lessonData.length, 6) }, () => 'stone'),
    ...Array.from({ length: Math.min(finishedSessions.length, 4) }, () => 'lantern'),
    ...Array.from({ length: qualifiedEvidence.length >= 5 && evidenceAccuracy >= 80 ? 2 : qualifiedEvidence.length >= 5 && evidenceAccuracy >= 60 ? 1 : 0 }, () => 'blossom'),
  ];
  if (!gardenPieces.length) gardenPieces.push('stone');
  gardenPieces.forEach((piece) => {
    const node = document.createElement('div');
    node.className = `garden-piece ${piece}`;
    gardenStrip.appendChild(node);
  });

  const milestones = [
    { label: 'First lesson', active: lessonData.length >= 1 },
    { label: 'Five lessons', active: lessonData.length >= 5 },
    { label: 'First session', active: finishedSessions.length >= 1 },
    { label: 'Five evidence checks', active: qualifiedEvidence.length >= 5 },
    { label: 'Long practice', active: totalMinutes >= 30 },
    { label: 'First boss', active: Object.values(bossData).some(isBossComplete) },
  ];
  milestones.forEach((milestone) => {
    const card = document.createElement('div');
    const state = milestone.active ? 'Earned' : 'Not earned';
    card.className = `milestone-chip ${milestone.active ? 'active' : ''}`;
    card.setAttribute('role', 'listitem');
    card.setAttribute('aria-label', `${milestone.label}: ${state.toLowerCase()}`);
    card.textContent = `${milestone.label} · ${state}`;
    milestoneRow.appendChild(card);
  });

  if (sessionData.length) {
    sessionData.slice(0, 4).forEach((entry) => {
      const card = document.createElement('article');
      card.className = 'session-card';
      const title = document.createElement('strong');
      title.textContent = entry.challengeTitle || entry.challengeKey
        ? `Challenge · ${entry.challengeTitle || entry.challengeKey}`
        : `${entry.type} · ${entry.level}`;
      const meta = document.createElement('p');
      meta.className = 'muted';
      const challengeResult = entry.challengeOutcome
        ? entry.challengeOutcome.valid === false
          ? 'Result unavailable for this saved rule version'
          : `${entry.challengeOutcome.met ? 'Target met' : 'Target not met yet'} · ${entry.challengeOutcome.metric === 'longestStreak' ? `streak ${entry.challengeOutcome.value}` : `${entry.challengeOutcome.value}/${entry.challengeOutcome.total} correct`}`
        : '';
      meta.textContent = entry.challengeUnavailable
        ? 'Result unavailable for this saved rule version'
        : entry.completed
          ? `Final accuracy ${entry.finalScore}/100${challengeResult ? ` · ${challengeResult}` : ''}`
        : `Progress ${entry.currentIndex}/${entry.questions.length}${entry.challengeTarget ? ` · Target: ${entry.challengeTarget}` : ''}`;
      card.append(title, meta);
      recentSessions.appendChild(card);
    });
  } else {
    recentSessions.innerHTML = '<div class="empty-state-card muted"><div class="empty-state-head"><span class="empty-state-mark">✦</span><strong>No recent sessions yet</strong></div><p>Finish one full practice session and it will appear here for quick review.</p></div>';
  }

  const reflectionItems = [
    lessonData.length ? `${lessonData.length} lesson stones` : 'Start one lesson',
    reviewProfile.total
      ? `${reviewProfile.total} ${reviewProfile.basis === 'first-check' ? 'first-check answer' : 'saved review item'}${reviewProfile.total === 1 ? '' : 's'} ready for review`
      : 'No current review signal',
    finishedSessions.length ? `${finishedSessions.length} finished sessions` : 'Finish your first session',
    qualifiedEvidence.length ? `${qualifiedEvidence.length} unassisted first-check sample(s)` : 'No first-check evidence yet',
  ];
  reflectionItems.forEach((text) => {
    const chip = document.createElement('span');
    chip.className = 'review-chip';
    chip.textContent = text;
    reflectionChips.appendChild(chip);
  });

  const reflectionTitle = reviewFocus ? `Review ${reviewFocus.target.skillLabel} next` : 'Keep the next step calm';
  const reflectionCopy = formatReviewBasis(reviewProfile);
  document.getElementById('reflection-title').textContent = reflectionTitle;
  document.getElementById('reflection-copy').textContent = reflectionCopy;

   const skillBuckets = ['abacus-orientation', 'number-reading', 'place-value', 'number-setting', 'addition', 'subtraction', 'complements', 'mixed-operations', 'multiplication', 'division', 'anzan', 'mastery'];
   const worksheetSubmodes = ['arithmetic-rhythm', 'complement-balance', 'sequence-signs', 'table-family', 'place-shifts', 'division-facts', 'quotient-building', 'anzan-recall'];
   const labelize = (value) => value.replace(/-/g, ' ');
  skillBuckets.forEach((skill) => {
    const lessonHits = lessonMeta.filter((entry) => entry.skill === skill && lessonData.includes(entry.id)).length;
    const exerciseHits = exerciseMeta.filter((entry) => entry.skill === skill && exerciseData[entry.id]).length;
    const reviewHits = exerciseMeta.filter((entry) => entry.skill === skill && exerciseData[entry.id]?.status === 'needs-review').length;
    const skillEvidence = qualifiedEvidence.filter(({ attempt }) => attempt.skill === skill);
    const correctEvidence = skillEvidence.filter(({ summary }) => summary.firstCheckCorrect).length;
    const evidencePercent = skillEvidence.length ? Math.round((correctEvidence / skillEvidence.length) * 100) : 0;
    const row = document.createElement('article');
    row.className = 'skill-row';
    const name = document.createElement('div');
    name.className = 'skill-label';
    name.innerHTML = `<strong>${labelize(skill)}</strong><small>${lessonHits} lessons · ${exerciseHits} exercise activities</small>`;
    const meter = document.createElement('div');
    meter.className = 'skill-meter';
    const evidenceReady = skillEvidence.length >= 5;
    const meterPercent = evidenceReady ? evidencePercent : Math.min(100, (skillEvidence.length / 5) * 100);
    meter.setAttribute('role', 'img');
    meter.setAttribute('aria-label', evidenceReady
      ? `${skill}: ${evidencePercent}% first-check accuracy from ${skillEvidence.length} samples`
      : `${skill}: ${skillEvidence.length} of 5 samples collected`);
    const fill = document.createElement('div');
    fill.className = 'skill-meter-fill';
    fill.style.width = `${meterPercent}%`;
    meter.appendChild(fill);
    const meta = document.createElement('span');
    meta.className = 'muted small';
    meta.textContent = evidenceReady
      ? `${evidencePercent}% unassisted first-check · ${skillEvidence.length} samples`
      : `Building evidence · ${skillEvidence.length}/5 samples · ${correctEvidence} first-check correct${reviewHits ? ` · ${reviewHits} review item(s)` : ''}`;
    const actions = document.createElement('div');
    actions.className = 'skill-actions';
    const practiceLink = document.createElement('a');
    practiceLink.href = toBaseHref(base, buildFocusedPracticeHref(exerciseMeta.find((entry) => entry.skill === skill)?.level, skill, { start: false }));
    practiceLink.className = 'text-link';
    practiceLink.textContent = 'Practice';
    const worksheetLink = document.createElement('a');
    worksheetLink.href = toBaseHref(base, buildFocusedWorksheetHref(skill, exerciseMeta.find((entry) => entry.skill === skill)?.level));
    worksheetLink.className = 'text-link';
    worksheetLink.textContent = 'Worksheet';
    actions.append(practiceLink, worksheetLink);
    row.append(name, meter, meta, actions);
     skillMap.appendChild(row);
   });

   worksheetSubmodes.forEach((submode) => {
     const sessions = worksheetData.filter((entry) => entry?.submode === submode || (submode === 'arithmetic-rhythm' && entry?.submode === 'auto'));
     const completed = sessions.filter((entry) => Number(entry.answered || 0) > 0).length;
     const bestAccuracy = sessions.reduce((best, entry) => Math.max(best, Number(entry.accuracy || 0)), 0);
     const row = document.createElement('article');
     row.className = 'skill-row';
     const name = document.createElement('div');
     name.className = 'skill-label';
     name.innerHTML = `<strong>${labelize(submode)}</strong><small>${completed} answered worksheet session${completed === 1 ? '' : 's'} · ${sessions.length} saved visit${sessions.length === 1 ? '' : 's'}</small>`;
     const meter = document.createElement('div');
     meter.className = 'skill-meter';
     const fill = document.createElement('div');
     fill.className = 'skill-meter-fill';
     const hasTraining = completed > 0;
     fill.style.width = `${hasTraining ? bestAccuracy : 0}%`;
     meter.setAttribute('role', 'img');
     meter.setAttribute('aria-label', hasTraining
       ? `${labelize(submode)}: best ${bestAccuracy}% checked result from ${completed} answered worksheet sessions`
       : `${labelize(submode)}: not trained yet`);
     meter.appendChild(fill);
     const meta = document.createElement('span');
     meta.className = 'muted small';
     meta.textContent = hasTraining ? `best checked result ${bestAccuracy}% · corrections included` : 'not trained yet';
     const actions = document.createElement('div');
     actions.className = 'skill-actions';
     const worksheetLink = document.createElement('a');
     const worksheetTarget = resolveWorksheetTarget({ submode });
     worksheetLink.href = toBaseHref(base, `worksheets?preset=${worksheetTarget.preset}&submode=${worksheetTarget.submode}`);
     worksheetLink.className = 'text-link';
     worksheetLink.textContent = 'Train';
     actions.append(worksheetLink);
     row.append(name, meter, meta, actions);
     worksheetFocusMount?.appendChild(row);
   });

  const resetButton = document.getElementById('reset-progress');
  const resetStatus = document.getElementById('reset-progress-status');
  if (!compatibility.writable && resetButton) {
    resetButton.disabled = true;
    resetStatus.textContent = compatibility.future
      ? 'Reset is disabled in this older read-only page so newer saved data is not removed.'
      : 'Reset is disabled while saved progress cannot be validated.';
  }
  resetButton?.addEventListener('click', () => {
    const confirmed = window.confirm('Reset all Soroban Dojo progress stored in this browser? This cannot be undone.');
    if (!confirmed) return;
    const result = clearProgressStorage(localStorage);
    if (!result.complete) {
      resetStatus.textContent = `Some local records could not be cleared (${result.failedKeys.length}). Close other tabs or check browser storage permissions, then retry.`;
      return;
    }
    let channelBroadcast = false;
    try {
      if ('BroadcastChannel' in window) {
        const channel = new BroadcastChannel('soroban-dojo:progress');
        channel.postMessage({ type: 'reset' });
        channel.close();
        channelBroadcast = true;
      }
    } catch {}
    const notice = result.broadcast || channelBroadcast
      ? 'Progress reset on this device. Display theme and unrelated browser data were preserved.'
      : 'Progress reset here. Other open Soroban Dojo tabs could not be notified; reload them before continuing.';
    try { sessionStorage.setItem('soroban-dojo:reset-notice', notice); } catch {}
    window.location.reload();
  });
</script>
