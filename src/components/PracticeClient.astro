---
interface ExerciseSummary {
  id: string;
  slug: string;
  title: string;
  level: string;
  skill: string;
}

interface Props {
  exercises: ExerciseSummary[];
}

import { CHALLENGE_LIST } from '../lib/challenges.js';
import ContinuityNextAction from './ContinuityNextAction.astro';

const { exercises } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section id="practice-client" class="practice-stack" data-library={JSON.stringify(exercises)} data-base={base}>
  <section class="panel practice-options practice-start-panel">
    <div class="section-head">
      <div>
        <p class="eyebrow">Dojo practice</p>
        <h2>Choose one training mode and begin</h2>
      </div>
      <span class="badge">Attempt first · 先に挑戦</span>
    </div>
    <ContinuityNextAction surface="practice" headingLevel="h3" />
  </section>

  <div class="practice-grid practice-main-grid">
    <section class="panel question-shell" id="practice-session" tabindex="-1">
      <div class="section-head">
        <div>
          <p class="eyebrow">Current session</p>
          <h2 id="session-title">No session selected yet</h2>
        </div>
      </div>
      <div id="practice-session-context" class="practice-session-context" hidden>
        <div class="practice-session-stats">
          <article class="stat-card stat-card-soft"><small>Progress:</small><span id="session-progress">0 / 0</span></article>
          <article class="stat-card stat-card-soft"><small>Accuracy:</small><span id="session-score">—</span></article>
          <article class="stat-card stat-card-soft"><small>Timer:</small><span id="session-timer">Off</span></article>
        </div>
        <div class="practice-session-meta">
          <div class="subtle-panel practice-meta-card"><strong>Session ID:</strong><span id="session-id" class="muted small">—</span></div>
          <div class="subtle-panel practice-meta-card"><strong>Adaptive focus:</strong><span id="session-adaptive-note" class="muted small">—</span></div>
          <div class="subtle-panel practice-meta-card"><strong>Profile:</strong><span id="session-profile" class="muted small">—</span></div>
          <div class="subtle-panel practice-meta-card" id="session-challenge-summary" hidden><strong>Challenge:</strong><span id="session-challenge-copy" class="muted small">—</span></div>
        </div>
        <div class="practice-learning-strip">
          <strong>Learning path</strong>
          <div class="button-row button-row-compact">
            <a class="button button-secondary" href={`${base}lessons`}>Browse lessons</a>
            <a class="button button-secondary" href={`${base}exercises`}>Open exercises</a>
            <a class="button button-secondary" href={`${base}worksheets`}>Open worksheets</a>
          </div>
        </div>
      </div>

      <div id="single-session-view" class="subtle-panel question-stage">
        <p class="eyebrow">Question</p>
        <h3 id="question-title">Choose a session to begin.</h3>
        <p id="question-prompt" class="muted">Curated lists follow the lessons; generated lists create replayable arithmetic practice.</p>
        <p id="practice-question-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
        <div id="visual-mount" class="subtle-panel visual-stage" hidden></div>
        <div class="practice-empty-note" id="practice-empty-note">
          <strong>Recommended start</strong>
          <p class="muted">Use the focused start above for one short session. Optional journeys and setup controls follow this practice area.</p>
        </div>
        <div id="practice-intent-feedback" class="reveal-panel" hidden role="status" aria-live="polite"></div>
        <div id="single-session-active" class="single-session-active" hidden>
          <label class="stack-sm answer-stack">
            <span>Your response · 記入</span>
            <input id="answer-input" class="input" type="text" inputmode="numeric" placeholder="Write your response before checking" />
          </label>

          <div class="button-row button-row-compact">
            <button class="button" id="verify-answer">Verify response</button>
            <button class="button button-secondary" id="reveal-final">Reveal answer</button>
            <button class="button button-secondary" id="reveal-steps">Reveal method</button>
            <button class="button button-secondary" id="next-question">Save and continue</button>
          </div>
          <div id="feedback-panel" class="reveal-panel" hidden role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></div>
          <div id="session-complete-actions" class="button-row button-row-compact session-complete-actions" hidden>
            <button class="button button-secondary session-replay-current" id="session-replay-current">Replay this list</button>
            <button class="button session-start-fresh" id="session-start-fresh">Start fresh</button>
          </div>
          <div class="question-flow-note">
            <span class="review-chip">1. Solve first</span>
            <span class="review-chip">2. Write your response</span>
            <span class="review-chip">3. Verify or reveal the answer</span>
          </div>
          <pre id="question-ledger" class="worksheet-ledger" hidden></pre>
          <div class="practice-next-strip">
            <strong>Quick path</strong>
            <div class="button-row button-row-compact">
              <button class="button button-secondary practice-preset" data-preset="practice">Focused practice preset</button>
              <button class="button button-secondary practice-preset" data-preset="review">Review current focus</button>
              <a class="button button-secondary" href={`${base}worksheets`}>Open worksheet</a>
            </div>
          </div>
        </div>
      </div>

      <div id="sheet-session-view" class="subtle-panel sheet-stage" hidden>
        <div class="section-head">
          <div>
            <p class="eyebrow">Soroban sheet · 用紙</p>
            <h3>Practice several questions at once</h3>
          </div>
          <button class="button button-secondary" id="print-sheet">Print sheet</button>
        </div>
        <div id="sheet-list" class="sheet-list"></div>
        <div class="button-row button-row-compact">
          <button class="button" id="check-sheet">Check sheet answers</button>
          <button class="button button-secondary" id="reveal-sheet-answers">Reveal sheet answers</button>
          <button class="button button-secondary" id="save-sheet">Save sheet progress</button>
        </div>
        <div id="sheet-feedback-panel" class="reveal-panel" hidden role="status" aria-live="polite" tabindex="-1"></div>
        <div id="sheet-session-complete-actions" class="button-row button-row-compact session-complete-actions" hidden>
          <button class="button button-secondary session-replay-current">Replay this list</button>
          <button class="button session-start-fresh">Start fresh</button>
        </div>
      </div>

      <div id="steps-panel" class="reveal-panel" hidden></div>
      <div id="recovery-panel" class="subtle-panel practice-recovery-panel" hidden>
        <p class="eyebrow">Recovery mode</p>
        <strong id="recovery-title">Repair the pattern calmly</strong>
        <p id="recovery-copy" class="muted small">If the first answer misses, switch to one quieter repair prompt before moving on.</p>
        <div class="button-row button-row-compact">
          <button class="button button-secondary" id="use-recovery-prompt">Use repair prompt</button>
          <button class="button button-secondary" id="leave-recovery-prompt" hidden>Return to original prompt</button>
          <button class="button button-secondary" id="reveal-recovery-method">Reveal method</button>
        </div>
      </div>
      <details class="practice-help-block" id="practice-session-help" hidden>
        <summary>How to use this session</summary>
        <div class="review-chip-row">
          <span class="review-chip">Verify only if you just want confirmation</span>
          <span class="review-chip">Reveal the final number when you want a quick check</span>
          <span class="review-chip">Reveal steps when you want to study the method</span>
          <span class="review-chip">Resume or replay later with the saved session ID</span>
        </div>
      </details>
    </section>

    <section class="panel practice-options practice-more-panel" aria-labelledby="practice-more-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">More practice routes</p>
          <h2 id="practice-more-title">Personalize the next session</h2>
        </div>
      </div>
      <details class="practice-discovery-block">
        <summary>More ways to train</summary>
      <div class="option-grid option-grid-compact practice-journey-grid">
        <article class="choice-card">
          <p class="eyebrow">Journey</p>
          <h3>Build foundations</h3>
          <p>Short visual-first drills for reading, one-rod moves, and calm confidence.</p>
          <div class="button-row button-row-compact">
            <button class="button button-secondary practice-journey-button" data-journey="foundations" aria-label="Use foundations journey preset">Use foundations journey</button>
            <button class="button button-secondary practice-journey-start" data-journey="foundations" aria-label="Start foundations journey now">Start foundations now</button>
          </div>
        </article>
        <article class="choice-card">
          <p class="eyebrow">Journey</p>
          <h3>Strengthen complements</h3>
          <p>Train five and ten complements until blocked moves feel cleaner and smaller.</p>
          <div class="button-row button-row-compact">
            <button class="button button-secondary practice-journey-button" data-journey="complements" aria-label="Use complements journey preset">Use complements journey</button>
            <button class="button button-secondary practice-journey-start" data-journey="complements" aria-label="Start complements journey now">Start complements now</button>
          </div>
        </article>
        <article class="choice-card">
          <p class="eyebrow">Journey</p>
          <h3>Mixed fluency</h3>
          <p>Hold full numbers through short mixed sequences before pushing speed.</p>
          <div class="button-row button-row-compact">
            <button class="button button-secondary practice-journey-button" data-journey="fluency" aria-label="Use mixed fluency journey preset">Use mixed fluency journey</button>
            <button class="button button-secondary practice-journey-start" data-journey="fluency" aria-label="Start mixed fluency journey now">Start mixed fluency now</button>
          </div>
        </article>
        <article class="choice-card">
          <p class="eyebrow">Journey</p>
          <h3>Multiply and divide</h3>
          <p>Work through table facts, place shifts, and quotient building in a steadier order.</p>
          <div class="button-row button-row-compact">
            <button class="button button-secondary practice-journey-button" data-journey="muldiv" aria-label="Use multiply and divide journey preset">Use mul/div journey</button>
            <button class="button button-secondary practice-journey-start" data-journey="muldiv" aria-label="Start multiply and divide journey now">Start mul/div now</button>
          </div>
        </article>
        <article class="choice-card">
          <p class="eyebrow">Journey</p>
          <h3>Mental mastery</h3>
          <p>Use anzan-style sessions to stabilize mental totals, rhythm, and error recovery.</p>
          <div class="button-row button-row-compact">
            <button class="button button-secondary practice-journey-button" data-journey="mastery" aria-label="Use mental mastery journey preset">Use mental mastery journey</button>
            <button class="button button-secondary practice-journey-start" data-journey="mastery" aria-label="Start mental mastery journey now">Start mental mastery now</button>
          </div>
        </article>
      </div>
      <div class="option-grid option-grid-compact practice-challenge-grid">
        {CHALLENGE_LIST.map((challenge) => (
          <article class="choice-card" data-challenge-card={challenge.key}>
            <p class="eyebrow">Challenge</p>
            <h3>{challenge.title}</h3>
            <p>{challenge.summary}</p>
            <p class="muted small"><strong>Target:</strong> {challenge.target}</p>
            <p class="muted small"><strong>Rule:</strong> {challenge.rule}</p>
            <div class="button-row button-row-compact">
              <button class="button button-secondary practice-challenge-button" data-challenge={challenge.key} aria-label={`Use ${challenge.title} challenge preset`}>Use {challenge.title}</button>
              <button class="button button-secondary practice-challenge-start" data-challenge={challenge.key} aria-label={`Start ${challenge.title} challenge now`}>Start {challenge.title}</button>
            </div>
          </article>
        ))}
      </div>
      </details>
      <details class="practice-setup-block">
        <summary>Adjust session setup</summary>
        <div class="practice-grid">
        <div class="stack-sm subtle-panel practice-config-panel">
          <p class="eyebrow">Session shape</p>
          <label class="stack-sm">
            <span>Practice format · 形式</span>
            <select id="session-format" class="select">
              <option value="single">One by one</option>
              <option value="sheet">Question sheet</option>
            </select>
          </label>
          <label class="stack-sm">
            <span>Session type · 稽古</span>
            <select id="session-type" class="select">
              <option value="curated">Curated list</option>
              <option value="generated">Generated drill</option>
            </select>
          </label>
          <label class="stack-sm">
            <span>Level focus · 段階</span>
            <select id="session-level" class="select">
              <option value="L0">L0 Foundations</option>
              <option value="L1">L1 Beginner</option>
              <option value="L2">L2 Complements</option>
              <option value="L3">L3 Mixed fluency</option>
              <option value="L4">L4 Multiplication &amp; division</option>
              <option value="L5">L5 Mastery review</option>
            </select>
          </label>
          <label class="stack-sm">
            <span>List length · 問題数</span>
            <select id="session-length" class="select">
              <option value="5">5 questions</option>
              <option value="10" selected>10 questions</option>
              <option value="15">15 questions</option>
              <option value="20">20 questions</option>
            </select>
          </label>
          <label class="stack-sm">
            <span>Digit range · 桁数</span>
            <select id="worksheet-digit-range" class="select">
              <option value="2-2">2 digits</option>
              <option value="2-3" selected>2-3 digits</option>
              <option value="3-4">3-4 digits</option>
              <option value="4-4">4 digits</option>
            </select>
          </label>
        </div>
        <div class="stack-sm subtle-panel practice-config-panel">
          <p class="eyebrow">Answering</p>
          <label class="stack-sm">
            <span>Operation range · 手順数</span>
            <select id="worksheet-operation-range" class="select">
              <option value="2-3" selected>2-3 ops</option>
              <option value="3-4">3-4 ops</option>
              <option value="4-6">4-6 ops</option>
              <option value="2-10">2-10 ops</option>
            </select>
          </label>
          <label class="stack-sm">
            <span>Operator mode · 記号</span>
            <select id="worksheet-operator-mode" class="select">
              <option value="add">Addition only</option>
              <option value="subtract">Subtraction only</option>
              <option value="mixed" selected>Mixed</option>
            </select>
          </label>
          <label class="stack-sm">
            <span>Check style · 確認</span>
            <select id="check-mode" class="select">
              <option value="verify">Verify only</option>
              <option value="final">Verify and show final number</option>
              <option value="steps">Verify and show steps</option>
              <option value="self-mark">Self-mark after reveal</option>
            </select>
          </label>
          <label class="stack-sm">
            <span>Timer · 時間</span>
            <select id="timer-mode" class="select">
              <option value="off">Timer off</option>
              <option value="on">Timer on</option>
            </select>
          </label>
          <label class="stack-sm">
            <span>Question style · 問題</span>
            <select id="question-style" class="select">
              <option value="mixed">Mixed</option>
              <option value="visual">Visual first</option>
              <option value="visual-read">Visual bead read</option>
              <option value="visual-five">Clean five read</option>
              <option value="mental">Mental prompt</option>
              <option value="adaptive">Adaptive review focus</option>
            </select>
          </label>
          <label class="stack-sm">
            <span>Term count · 項数</span>
            <select id="term-count" class="select">
              <option value="auto" selected>Auto</option>
              <option value="2">2 terms</option>
              <option value="3">3 terms</option>
              <option value="4">4 terms</option>
            </select>
          </label>
          <div class="button-row">
            <button class="button" id="start-session">Start new session</button>
            <button class="button button-secondary" id="resume-latest">Resume latest</button>
          </div>
          <label class="stack-sm">
            <span>Resume by session ID · 続き</span>
            <input id="session-id-input" class="input" type="text" placeholder="Paste a saved session ID" />
          </label>
          <button class="button button-secondary" id="resume-by-id">Open saved ID</button>
        </div>
      </div>
      </details>
      <div class="subtle-panel practice-current-setup" role="status" aria-live="polite">
        <strong>Current setup</strong>
        <span id="practice-current-setup-copy" class="muted small">Format: single · Source: curated · Level: L0 · Questions: 10 · Style: mixed · Terms: auto · Timer: off</span>
      </div>
      <details class="disclosure-block practice-guidance-block">
        <summary>Why this setup fits</summary>
        <div class="practice-guidance-content">
          <div class="subtle-panel practice-mode-guide">
            <strong id="practice-mode-guide-title">Recommended use</strong>
            <p id="practice-guide-copy" class="muted small">Use this setup for short focused repetition before moving to sheets or review.</p>
          </div>
          <div class="subtle-panel practice-purpose-strip">
            <strong>Best for</strong>
            <span id="practice-purpose-copy" class="muted small">short guided repetitions</span>
          </div>
          <div class="subtle-panel practice-journey-mode">
            <strong id="journey-mode-title">Journey mode</strong>
            <p id="journey-mode-copy" class="muted small">Pick a journey to switch from generic presets into a more distinct practice format.</p>
          </div>
        </div>
      </details>
    </section>

    <aside class="panel stack-sm side-panel">
      <details class="collapsible-block" id="history-block">
        <summary>
          <span>
            <p class="eyebrow">Session history</p>
            <h2>Resume or replay</h2>
          </span>
        </summary>
        <div id="history-list" class="session-list">
          <div class="empty-state-card muted"><div class="empty-state-head"><span class="empty-state-mark">✦</span><strong>No saved sessions yet</strong></div><p>Your saved sessions will appear here after you complete or pause one practice session.</p></div>
        </div>
      </details>

      <details class="collapsible-block" open>
        <summary>
          <span>
            <p class="eyebrow">Exercise library</p>
            <h3>Study by lesson if you prefer</h3>
          </span>
        </summary>
        <ul class="list-clean compact-library">
          {exercises.slice(0, 6).map((exercise) => (
            <li>
              <strong>{exercise.title}</strong>
              <div class="meta-row">
                <span>{exercise.level}</span>
                <span>{exercise.skill}</span>
              </div>
              <a class="text-link" href={`${base}exercises/${exercise.slug}`}>Open library item →</a>
            </li>
          ))}
        </ul>
      </details>

      <div class="subtle-panel sora-sheet-note">
        <p class="eyebrow">Soroban sheets</p>
        <p class="muted">Use sheet mode when you want many questions at once, or print worksheets for desk-style repetition.</p>
      </div>
    </aside>
  </div>
</section>

<script>
  // @ts-nocheck
  import { CHALLENGE_DEFINITIONS, buildChallengeQuestions, canonicalizeChallengeSession, certifyChallengeQuestions, evaluateChallengeOutcome, formatChallengeOutcome, isChallengeSessionOpaque } from '../lib/challenges.js';
  import { buildContinuityRecommendation, formatReviewBasis, normalizeResumablePracticeSession, normalizeViewablePracticeSession, readContinuitySnapshot, readReviewProfile, resolveReviewFocus, resolveReviewTargetForLevel, targetForSkill, toBaseHref } from '../lib/learner-continuity.js';
  import { appendEvidenceEvent, claimMasteryItem, createAttemptEvidence, masteryClaimOwnedBy, normalizeAttemptEvidence, normalizeMasterySeenIndex, summarizeAttemptEvidence, upsertAttemptEvidence } from '../lib/mastery.js';
  import { buildCuratedPracticeQuestions, buildGeneratedPracticeQuestions, buildJourneyPracticeQuestions, practiceSlug, preparePracticeResponseForAdvance } from '../lib/practice.js';
  import { STORAGE_KEYS, normalizeStoredArray, normalizeStoredRecord, readStoredArray, readStoredJson, writeStoredJson } from '../lib/storage.js';
  import { ensureStorageCompatibility } from '../lib/storage-migrations.js';
  import { buildGeneratedWorksheetQuestions, buildWorksheetProfileLabel, createWorksheetProfile } from '../lib/worksheet.js';

  ensureStorageCompatibility(localStorage);

  const root = document.querySelector('.practice-stack');
  const library = JSON.parse(root?.dataset.library || '[]');
  const SESSION_KEY = STORAGE_KEYS.practiceSessions;
  const TIMER_KEY = STORAGE_KEYS.timerHistory;
  const EXERCISE_STATE_KEY = STORAGE_KEYS.exerciseStates;
  let currentSession = null;
  let selectedJourneyKey = null;
  let selectedSkillKey = null;
  let selectedChallengeKey = null;
  let timerInterval = null;
  let questionStartedAt = null;
  let activeTimerKey = null;
  const audioWindow = typeof window !== 'undefined' ? /** @type {any} */ (window) : null;
  const AudioContextCtor = audioWindow
    ? audioWindow.AudioContext || (audioWindow).webkitAudioContext || null
    : null;
  const audioCtx = AudioContextCtor ? new AudioContextCtor() : null;
  const playTone = (type) => {
    if (!audioCtx) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sine';
    const start = audioCtx.currentTime;
    const freqA = type === 'success' ? 660 : 280;
    const freqB = type === 'success' ? 880 : 220;
    osc.frequency.setValueAtTime(freqA, start);
    osc.frequency.linearRampToValueAtTime(freqB, start + 0.16);
    gain.gain.setValueAtTime(0.0001, start);
    gain.gain.linearRampToValueAtTime(0.028, start + 0.02);
    gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.2);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(start + 0.22);
  };

  const byId = (id) => document.getElementById(id);
  const feedbackForCurrent = () => currentSession?.format === 'sheet'
    ? byId('sheet-feedback-panel')
    : byId('feedback-panel');
  const normalizePracticeSession = (entry) => {
    if (!entry || typeof entry !== 'object' || Array.isArray(entry)) return null;
    if (isChallengeSessionOpaque(entry)) {
      const opaque = canonicalizeChallengeSession({ ...entry, responses: normalizeStoredRecord(entry.responses) });
      return { ...opaque, questions: Array.isArray(entry.questions) ? entry.questions : [] };
    }
    if (!Array.isArray(entry.questions)) return null;
    const normalized = {
      ...entry,
      responses: normalizeStoredRecord(entry.responses),
    };
    return canonicalizeChallengeSession(normalized);
  };
  const renderPrimaryPracticeAction = () => {
    const action = document.getElementById('practice-primary-action');
    if (!(action instanceof HTMLAnchorElement)) return;
    const recommendation = buildContinuityRecommendation(readContinuitySnapshot(localStorage));
    const target = recommendation.kind === 'setup'
      ? { href: 'practice?level=L0&skill=abacus-orientation&start=1', label: 'Start focused practice' }
      : recommendation.primary;
    action.href = toBaseHref(root?.dataset.base || '/soroban-dojo/', target.href);
    action.textContent = target.label;
    action.dataset.continuityKind = recommendation.kind;
  };
  const readRawSessions = () => normalizeStoredArray(readStoredJson(localStorage, SESSION_KEY, []));
  const readSessions = () => {
    try {
      return readRawSessions()
        .map(normalizePracticeSession)
        .filter(Boolean);
    } catch { return []; }
  };
  const writeSessions = (sessions) => {
    const saved = writeStoredJson(localStorage, SESSION_KEY, normalizeStoredArray(sessions));
    if (saved) window.dispatchEvent(new CustomEvent('soroban:continuity-change'));
    return saved;
  };
  const appendTimer = (entry) => {
    try {
      const current = normalizeStoredArray(readStoredJson(localStorage, TIMER_KEY, []));
      current.push(entry);
      writeStoredJson(localStorage, TIMER_KEY, current.slice(-200));
    } catch {}
  };
  const readExerciseStates = () => {
    try { return normalizeStoredRecord(readStoredJson(localStorage, EXERCISE_STATE_KEY, {})); } catch { return {}; }
  };
  const writeExerciseStates = (state) => writeStoredJson(localStorage, EXERCISE_STATE_KEY, normalizeStoredRecord(state));
  const readAdaptiveReviewProfile = () => readReviewProfile(localStorage, readExerciseStates());
  const snapshotReviewProfile = (profile) => ({
    basis: profile?.basis || 'none',
    focus: profile?.focus ? { ...profile.focus } : null,
    total: Number(profile?.total || 0),
    historyIncomplete: profile?.historyIncomplete === true,
    missingClaimDetails: Number(profile?.missingClaimDetails || 0),
  });

  const applyPracticeLevelDefaults = (level) => {
    const format = byId('session-format');
    const length = byId('session-length');
    const checkMode = byId('check-mode');
    const questionStyle = byId('question-style');
    const termCount = byId('term-count');
    if (!format || !length || !checkMode || !questionStyle || !termCount) return;
    if (level === 'L0') {
      format.value = 'single';
      length.value = '5';
      checkMode.value = 'final';
      questionStyle.value = 'visual';
      termCount.value = '2';
    } else if (level === 'L1') {
      format.value = 'single';
      length.value = '10';
      checkMode.value = 'final';
      questionStyle.value = 'mixed';
      termCount.value = '2';
    } else if (level === 'L2') {
      format.value = 'single';
      length.value = '10';
      checkMode.value = 'steps';
      questionStyle.value = 'mixed';
      termCount.value = '3';
    } else if (level === 'L3') {
      format.value = 'sheet';
      length.value = '10';
      checkMode.value = 'verify';
      questionStyle.value = 'mixed';
      termCount.value = '3';
    } else if (level === 'L4') {
      format.value = 'sheet';
      length.value = '15';
      checkMode.value = 'verify';
      questionStyle.value = 'mixed';
      termCount.value = '3';
    } else {
      format.value = 'single';
      length.value = '10';
      checkMode.value = 'steps';
      questionStyle.value = 'mental';
      termCount.value = '4';
    }
  };

  const describeAdaptivePractice = (session) => {
    const reviewProfile = session?.adaptiveReviewProfile || snapshotReviewProfile(readAdaptiveReviewProfile());
    const selectedTarget = targetForSkill(session?.skill, session?.level)
      || resolveReviewTargetForLevel(reviewProfile, session?.level)?.target;
    const selectedCopy = selectedTarget
      ? `${selectedTarget.skillLabel} at ${selectedTarget.level}.`
      : `Level ${session?.level || 'unknown'} default.`;
    return `${selectedCopy} ${formatReviewBasis(reviewProfile)}`;
  };

  const makeId = () => `dojo-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;

  const presets = {
    warmup: { format: 'single', type: 'curated', level: 'L0', length: '5', checkMode: 'final', timerMode: 'off', questionStyle: 'visual', termCount: '2' },
    practice: { format: 'single', type: 'generated', level: 'L0', length: '5', checkMode: 'final', timerMode: 'off', questionStyle: 'visual', termCount: '2' },
    review: { format: 'sheet', type: 'generated', level: 'L2', length: '10', checkMode: 'steps', timerMode: 'off', questionStyle: 'adaptive', termCount: '3' },
    speed: { format: 'single', type: 'generated', level: 'L3', length: '20', checkMode: 'verify', timerMode: 'on', questionStyle: 'mixed', termCount: '3' },
    mental: { format: 'single', type: 'generated', level: 'L5', length: '10', checkMode: 'steps', timerMode: 'off', questionStyle: 'mental', termCount: '4' },
  };

  const journeys = {
    foundations: { title: 'Build foundations', modeCopy: 'Visual reading chain with bead-first prompts and short calm wins.', format: 'single', type: 'generated', level: 'L0', length: '5', checkMode: 'final', timerMode: 'off', questionStyle: 'visual', termCount: '2' },
    complements: { title: 'Strengthen complements', modeCopy: 'Missing-part chain that stays inside five and ten complements.', format: 'single', type: 'generated', level: 'L2', length: '10', checkMode: 'steps', timerMode: 'off', questionStyle: 'mixed', termCount: '3' },
    fluency: { title: 'Mixed fluency', modeCopy: 'Running-total relay with short mixed sequences instead of generic question picks.', format: 'single', type: 'generated', level: 'L3', length: '10', checkMode: 'verify', timerMode: 'off', questionStyle: 'mixed', termCount: '3' },
    muldiv: { title: 'Multiply and divide', modeCopy: 'Alternating product-and-quotient ladder to keep fact families connected.', format: 'single', type: 'generated', level: 'L4', length: '10', checkMode: 'verify', timerMode: 'off', questionStyle: 'mixed', termCount: '3' },
    mastery: { title: 'Mental mastery', modeCopy: 'Mental ladder with fixed anzan-style sequences and recovery rhythm.', format: 'single', type: 'generated', level: 'L5', length: '10', checkMode: 'steps', timerMode: 'off', questionStyle: 'mental', termCount: '4' },
  };

  const syncPracticeSetupCopy = () => {
    const target = byId('practice-current-setup-copy');
    const guideTitle = byId('practice-mode-guide-title');
    const guideCopy = byId('practice-guide-copy');
    const purposeCopy = byId('practice-purpose-copy');
    const journeyModeTitle = byId('journey-mode-title');
    const journeyModeCopy = byId('journey-mode-copy');
    if (!target) return;
    const selectedChallenge = selectedChallengeKey ? CHALLENGE_DEFINITIONS[selectedChallengeKey] : null;
    target.textContent = `${selectedChallenge ? `Challenge: ${selectedChallenge.title} · ` : ''}Format: ${byId('session-format').value} · Source: ${byId('session-type').value} · Level: ${byId('session-level').value}${selectedSkillKey ? ` · Focus: ${selectedSkillKey.replace(/-/g, ' ')}` : ''} · Questions: ${byId('session-length').value} · Style: ${byId('question-style').value} · Terms: ${byId('term-count').value} · Timer: ${byId('timer-mode').value}`;
    if (!guideTitle || !guideCopy || !purposeCopy) return;
    const format = byId('session-format').value;
    const style = byId('question-style').value;
    const level = byId('session-level').value;
    if (format === 'sheet') {
      guideTitle.textContent = 'Best for dense worksheet-style practice';
      guideCopy.textContent = 'Use sheet mode when you want many questions at once, calmer review, or something close to printed drill work.';
      purposeCopy.textContent = 'dense review and worksheet-style repetition';
    } else if (style === 'mental') {
      guideTitle.textContent = 'Best for mental / anzan focus';
      guideCopy.textContent = 'This setup is tuned for mental work. Solve without moving beads, then verify carefully.';
      purposeCopy.textContent = 'mental focus, attention, and anzan rhythm';
    } else if (level === 'L0' || level === 'L1') {
      guideTitle.textContent = 'Best for guided fundamentals';
      guideCopy.textContent = 'This setup favors shorter, clearer drills so you can build confidence before increasing length or speed.';
      purposeCopy.textContent = 'foundations, accuracy, and calm warm-ups';
    } else {
      guideTitle.textContent = 'Best for steady mixed practice';
      guideCopy.textContent = 'Use this configuration to keep rhythm while building fluency across several related drill types.';
      purposeCopy.textContent = 'steady fluency, review, and progression';
    }
    if (journeyModeTitle && journeyModeCopy) {
      const journey = selectedJourneyKey ? journeys[selectedJourneyKey] : null;
      journeyModeTitle.textContent = journey ? `Journey mode · ${journey.title}` : 'Journey mode';
      journeyModeCopy.textContent = journey ? journey.modeCopy : 'Pick a journey to switch from generic presets into a more distinct practice format.';
    }
  };

  const applyPreset = (key) => {
    selectedJourneyKey = null;
    selectedSkillKey = null;
    selectedChallengeKey = null;
    const preset = presets[key];
    if (!preset) return;
    byId('session-format').value = preset.format;
    byId('session-type').value = preset.type;
    byId('session-level').value = preset.level;
    byId('session-length').value = preset.length;
    byId('check-mode').value = preset.checkMode;
    byId('timer-mode').value = preset.timerMode;
    byId('question-style').value = preset.questionStyle;
    byId('term-count').value = preset.termCount;
    if (key === 'review') {
      const reviewFocus = resolveReviewFocus(readAdaptiveReviewProfile());
      if (reviewFocus) {
        byId('session-level').value = reviewFocus.target.level;
        selectedSkillKey = reviewFocus.target.skill;
      }
    }
    syncPracticeSetupCopy();
  };

  const applyJourney = (key) => {
    const journey = journeys[key];
    if (!journey) return;
    selectedJourneyKey = key;
    selectedSkillKey = null;
    selectedChallengeKey = null;
    byId('session-format').value = journey.format;
    byId('session-type').value = journey.type;
    byId('session-level').value = journey.level;
    byId('session-length').value = journey.length;
    byId('check-mode').value = journey.checkMode;
    byId('timer-mode').value = journey.timerMode;
    byId('question-style').value = journey.questionStyle;
    byId('term-count').value = journey.termCount;
    syncPracticeSetupCopy();
  };

  const startFromPreset = (key) => {
    applyPreset(key);
    byId('start-session')?.click();
  };

  const startFromJourney = (key) => {
    applyJourney(key);
    byId('start-session')?.click();
  };

  const applyChallenge = (key) => {
    selectedJourneyKey = null;
    selectedSkillKey = null;
    const challenge = CHALLENGE_DEFINITIONS[key];
    if (!challenge) return;
    selectedChallengeKey = key;
    byId('session-format').value = challenge.config.format;
    byId('session-type').value = challenge.config.type;
    byId('session-level').value = challenge.config.level;
    byId('session-length').value = String(challenge.config.length);
    byId('check-mode').value = challenge.config.checkMode;
    byId('timer-mode').value = challenge.config.timerMode;
    byId('question-style').value = challenge.config.questionStyle;
    byId('term-count').value = challenge.config.termCount;
    syncPracticeSetupCopy();
  };

  const syncControlsFromSession = (session) => {
    if (!session) return;
    selectedJourneyKey = session.journeyKey || null;
    selectedSkillKey = session.skill || null;
    selectedChallengeKey = session.challengeKey || null;
    byId('session-format').value = session.format;
    byId('session-type').value = session.type;
    byId('session-level').value = session.level;
    byId('session-length').value = String(session.length);
    byId('check-mode').value = session.checkMode;
    byId('timer-mode').value = session.timerEnabled ? 'on' : 'off';
    byId('question-style').value = session.questionStyle;
    byId('term-count').value = session.termCount;
    syncPracticeSetupCopy();
  };

  const startFromChallenge = (key) => {
    applyChallenge(key);
    byId('start-session')?.click();
  };

  const createSession = ({ type, level, length, checkMode, timerEnabled, format, questionStyle, termCount, journeyKey, skill, challengeKey }) => {
    const sessionId = makeId();
    const adaptiveProfile = questionStyle === 'adaptive' ? readAdaptiveReviewProfile() : null;
    const adaptiveTarget = adaptiveProfile ? resolveReviewTargetForLevel(adaptiveProfile, level)?.target : null;
    const resolvedSkill = skill || adaptiveTarget?.skill || null;
    const worksheetProfile = createWorksheetProfile({
      digitRange: byId('worksheet-digit-range')?.value,
      operationRange: byId('worksheet-operation-range')?.value,
      operatorMode: byId('worksheet-operator-mode')?.value,
    });
    const challenge = challengeKey ? CHALLENGE_DEFINITIONS[challengeKey] : null;
    const questions = challenge
      ? buildChallengeQuestions({ challengeKey, seed: sessionId })
      : journeyKey
        ? buildJourneyPracticeQuestions(journeyKey, length, sessionId)
        : type === 'curated'
          ? buildCuratedPracticeQuestions(level, length, sessionId)
          : level === 'L3' && format === 'sheet'
            ? buildGeneratedWorksheetQuestions({ level, length, sessionId, profile: worksheetProfile }).map((question) => ({
            ...question,
            progressKey: `generated-${practiceSlug(`${question.answer}-${question.id}`)}`,
        }))
          : buildGeneratedPracticeQuestions(level, length, sessionId, questionStyle, termCount, resolvedSkill, adaptiveProfile);
    if (challenge) {
      const certification = certifyChallengeQuestions(challengeKey, questions);
      if (!certification.valid) throw new Error(`Challenge certification failed: ${certification.errors.join('; ')}`);
    }
    return {
      id: sessionId,
      type,
      level,
      length,
      worksheetProfile: type === 'generated' ? worksheetProfile : null,
      checkMode,
      timerEnabled,
      format,
      questionStyle,
      termCount,
      journeyKey: journeyKey || null,
      journeyTitle: journeyKey ? journeys[journeyKey]?.title || null : null,
      skill: resolvedSkill,
      adaptiveReviewProfile: adaptiveProfile ? snapshotReviewProfile(adaptiveProfile) : null,
      challengeKey: challengeKey || null,
      challengeTitle: challenge?.title || null,
      challengeTarget: challenge?.target || null,
      challengeRule: challenge?.rule || null,
      challengeRuleVersion: challenge?.ruleVersion ?? null,
      challengeSeed: challenge ? sessionId : null,
      challengeOutcome: null,
      evidenceVersion: 1,
      evidenceEligibility: 'prospective',
      createdAt: new Date().toISOString(),
      currentIndex: 0,
      completed: false,
      questions,
      responses: {},
      finalScore: null,
    };
  };

  const persistCurrent = () => {
    if (!currentSession) return false;
    const rawSessions = readRawSessions();
    const opaqueSessions = rawSessions.filter(isChallengeSessionOpaque);
    const sessions = rawSessions
      .filter((entry) => !isChallengeSessionOpaque(entry))
      .map(normalizePracticeSession)
      .filter(Boolean)
      .filter((entry) => entry.id !== currentSession.id);
    sessions.unshift(currentSession);
    return writeSessions([...sessions.slice(0, 12), ...opaqueSessions]);
  };

  const replaySession = (session) => {
    const source = normalizePracticeSession(session);
    if (!source) return;
    if (source.challengeUnavailable) {
      const feedback = byId('feedback-panel');
      feedback.hidden = false;
      feedback.textContent = 'This saved challenge uses an unsupported rule version. Its record is preserved, but it cannot be resumed or replayed.';
      return;
    }
    stopTimer();
    currentSession = {
      ...source,
      id: makeId(),
      createdAt: new Date().toISOString(),
      currentIndex: 0,
      completed: false,
      responses: {},
      finalScore: null,
      challengeOutcome: null,
      evidenceVersion: 1,
      evidenceEligibility: 'activity-only',
    };
    syncControlsFromSession(currentSession);
    persistCurrent();
    renderHistory();
    renderSession();
    focusCurrentQuestion();
  };

  const focusCurrentQuestion = () => {
    window.requestAnimationFrame(() => {
      const session = byId('practice-session');
      const stage = currentSession?.format === 'sheet' ? byId('sheet-session-view') : byId('single-session-view');
      const target = currentSession?.format === 'sheet'
        ? document.querySelector('#sheet-list .input')
        : byId('answer-input');
      stage?.scrollIntoView({ block: 'start' });
      if (!currentSession?.completed && target instanceof HTMLElement) target.focus({ preventScroll: true });
      else session?.focus({ preventScroll: true });
    });
  };

  const announceCurrentQuestion = (outcome = '') => {
    const status = byId('practice-question-status');
    if (!status || !currentSession || currentSession.completed || currentSession.format === 'sheet') return;
    const question = currentSession.questions[currentSession.currentIndex];
    const nextQuestion = `Question ${currentSession.currentIndex + 1} of ${currentSession.questions.length}: ${question.title}. ${question.prompt}`;
    status.textContent = outcome ? `${outcome} Next: ${nextQuestion}` : nextQuestion;
  };

  const applyWriteCellShortcut = (event) => {
    const input = event.currentTarget;
    if (!(input instanceof HTMLInputElement) || event.metaKey || event.ctrlKey || event.altKey) return false;
    if (event.key === '*' || event.code === 'NumpadMultiply') {
      event.preventDefault();
      input.value = '';
      return true;
    }
    if (event.key === '-' || event.code === 'NumpadSubtract') {
      event.preventDefault();
      input.value = input.value.slice(0, -1);
      return true;
    }
    return false;
  };

  const responseForCurrent = () => currentSession?.responses?.[currentSession.currentIndex] || {
    input: '',
    hintsUsed: 0,
    revealedFinal: false,
    revealedSteps: false,
    verified: false,
    correct: false,
    seconds: 0,
    recoveryPrompt: '',
    recoveryAnswer: null,
    recoveryMode: false,
    recoveryUsed: false,
    attempts: 0,
  };

  const evidenceForQuestion = (questionIndex, response = currentSession?.responses?.[questionIndex]) => {
    const storedEvidence = normalizeAttemptEvidence(response?.evidence);
    if (storedEvidence) return storedEvidence;
    const question = currentSession?.questions?.[questionIndex];
    if (!currentSession || !question) return null;
    const itemId = question.progressKey || question.id;
    const seenItems = normalizeMasterySeenIndex(readStoredJson(localStorage, STORAGE_KEYS.masterySeenItems, {}));
    const priorExposure = seenItems.claims.some((claim) => claim.itemId === itemId)
      || readStoredArray(localStorage, STORAGE_KEYS.masteryEvidence)
        .some((attempt) => attempt?.itemId === itemId && Array.isArray(attempt.events) && attempt.events.length > 0);
    return createAttemptEvidence({
      attemptId: `${currentSession.id}:question:${questionIndex}`,
      source: currentSession.challengeKey ? 'challenge' : 'practice',
      itemId,
      skill: question.skill || currentSession.level,
      level: currentSession.level,
      rule: {
        id: currentSession.challengeKey || question.challengeData?.kind || question.skill || 'practice-question',
        version: currentSession.challengeRuleVersion || 1,
      },
      seed: currentSession.challengeSeed || currentSession.id,
      startedAt: currentSession.createdAt,
      eligibility: currentSession.evidenceVersion === 1
        && currentSession.evidenceEligibility === 'prospective'
        && !priorExposure
        ? 'prospective'
        : 'activity-only',
    });
  };

  const appendQuestionEvidence = (questionIndex, response, event) => {
    const evidence = evidenceForQuestion(questionIndex, response);
    return evidence ? appendEvidenceEvent(evidence, event) : null;
  };

  const persistQuestionEvidence = (questionIndex) => {
    let evidence = currentSession?.responses?.[questionIndex]?.evidence;
    if (!evidence) return true;
    const claim = claimMasteryItem(readStoredJson(localStorage, STORAGE_KEYS.masterySeenItems, {}), {
      itemId: evidence.itemId,
      attemptId: evidence.attemptId,
      firstSeenAt: evidence.events[0]?.at || evidence.startedAt,
    });
    const claimSaved = !claim.changed || writeStoredJson(localStorage, STORAGE_KEYS.masterySeenItems, claim.index);
    const claimOwned = claim.eligible
      && claimSaved
      && masteryClaimOwnedBy(readStoredJson(localStorage, STORAGE_KEYS.masterySeenItems, {}), evidence.itemId, evidence.attemptId);
    if (!claimOwned) evidence = { ...evidence, eligibility: 'activity-only' };
    let ledger = upsertAttemptEvidence(readStoredArray(localStorage, STORAGE_KEYS.masteryEvidence), evidence);
    let persisted = ledger.find((attempt) => attempt.attemptId === evidence.attemptId) || { ...evidence, eligibility: 'activity-only' };
    currentSession.responses[questionIndex].evidence = persisted;
    let evidenceSaved = writeStoredJson(localStorage, STORAGE_KEYS.masteryEvidence, ledger);
    if (!evidenceSaved) currentSession.responses[questionIndex].evidence = { ...persisted, eligibility: 'activity-only' };
    const ownershipStable = persisted.eligibility !== 'prospective'
      || masteryClaimOwnedBy(readStoredJson(localStorage, STORAGE_KEYS.masterySeenItems, {}), persisted.itemId, persisted.attemptId);
    if (evidenceSaved && !ownershipStable) {
      persisted = { ...persisted, eligibility: 'activity-only' };
      ledger = upsertAttemptEvidence(readStoredArray(localStorage, STORAGE_KEYS.masteryEvidence), persisted);
      currentSession.responses[questionIndex].evidence = ledger.find((attempt) => attempt.attemptId === persisted.attemptId) || persisted;
      evidenceSaved = writeStoredJson(localStorage, STORAGE_KEYS.masteryEvidence, ledger);
    }
    return claimSaved && evidenceSaved;
  };

  const computeQuestionScore = (response) => {
    if (!response || !response.verified) return 0;
    return response.correct ? 100 : 0;
  };

  const computeSessionScore = (session) => {
    const total = session.questions.reduce((sum, _, index) => sum + computeQuestionScore(session.responses[index]), 0);
    return Math.round(total / session.questions.length);
  };

  const stopTimer = () => {
    if (timerInterval) window.clearInterval(timerInterval);
    timerInterval = null;
    if (!currentSession || !currentSession.timerEnabled || !questionStartedAt) return;
    const seconds = Math.max(1, Math.round((Date.now() - questionStartedAt) / 1000));
    const existing = responseForCurrent();
    currentSession.responses[currentSession.currentIndex] = { ...existing, seconds: (existing.seconds || 0) + seconds };
    appendTimer({ id: currentSession.id, questionIndex: currentSession.currentIndex, seconds, endedAt: new Date().toISOString() });
    questionStartedAt = null;
    activeTimerKey = null;
  };

  const syncExerciseProgress = (questionIndex = currentSession?.currentIndex) => {
    if (!currentSession) return false;
    const question = currentSession.questions[questionIndex];
    const response = currentSession.responses?.[questionIndex];
    if (!question || !response?.verified) return false;
    const existing = readExerciseStates();
    existing[question.progressKey || question.id] = {
      status: response.correct ? 'got-it' : 'needs-review',
      sessionId: currentSession.id,
      level: currentSession.level,
      skill: question.skill || (currentSession.level === 'L4'
        ? 'multiplication'
        : currentSession.level === 'L5'
          ? 'anzan'
          : currentSession.level === 'L2'
            ? 'complements'
            : 'arithmetic'),
      updatedAt: new Date().toISOString(),
    };
    const stateSaved = writeExerciseStates(existing);
    const evidenceSaved = persistQuestionEvidence(questionIndex);
    return stateSaved && evidenceSaved;
  };

  const buildRecoveryPrompt = (question, level, wrongValue) => {
    const guess = String(wrongValue || 'that result');
    if (level === 'L2') {
      return {
        prompt: `Recovery prompt: the missing part was not ${guess}. What number really completes this pattern?`,
        answer: question.answer,
      };
    }
    if (level === 'L4') {
      return {
        prompt: `Repair this result: ${question.prompt} = ${guess}. What should the correct value be?`,
        answer: question.answer,
      };
    }
    if (level === 'L3' || level === 'L5') {
      return {
        prompt: `Repair the running total calmly. If the result is not ${guess}, what should the final value be?`,
        answer: question.answer,
      };
    }
    return {
      prompt: `Repair the rod reading. If it is not ${guess}, what number should it show instead?`,
      answer: question.answer,
    };
  };

  const verificationFeedback = (response, question) => {
    if (currentSession?.challengeKey) {
      const evidence = summarizeAttemptEvidence(response.evidence);
      const saveNote = response.persistenceFailed ? ' This result remains available in this tab, but some progress data could not be saved.' : '';
      if (response.correct && evidence.qualified && evidence.firstCheckCorrect) {
        const reviewNote = response.revealedSteps || response.revealedFinal ? ' Review opened after the scored first check.' : '';
        return `Correct on the first check. This counts toward the challenge target.${reviewNote}${saveNote}`;
      }
      if (response.revealedSteps) return `Method revealed. The answer is ${question.answer}; this question does not count toward the first-check target.${saveNote}`;
      if (response.revealedFinal) return `Answer revealed: ${question.answer}. This question does not count toward the first-check target.${saveNote}`;
      if (response.correct) return `Correction is right, but it does not count toward the first-check target.${saveNote}`;
      if (evidence.qualified && evidence.checks === 1) return `First check missed. A correction can build skill, but it will not count toward the first-check target.${saveNote}`;
      return `Not correct yet. Keep repairing the answer; first-check credit is no longer available for this question.${saveNote}`;
    }
    const evidence = summarizeAttemptEvidence(response.evidence);
    const saveNote = response.persistenceFailed ? ' This result remains available in this tab, but some progress data could not be saved.' : '';
    const reviewNote = response.reviewedStepsAfterCheck
      ? ` Answer: ${question.answer}. The full step method is open below.`
      : response.reviewedFinalAfterCheck
        ? ` Answer: ${question.answer}.`
        : '';
    const withOutcomeNotes = (copy) => `${copy}${reviewNote}${saveNote}`;
    const assistanceUsed = evidence.assisted || response.revealedFinal || response.revealedSteps || response.recoveryUsed;
    const activityOnly = response.evidence?.eligibility === 'activity-only';
    if (response.correct && evidence.qualified && evidence.firstCheckCorrect) {
      const laterReviewNote = assistanceUsed ? ' Later review did not remove that first-check evidence.' : '';
      return withOutcomeNotes(`Correct on first check. This counts as unassisted first-check evidence.${laterReviewNote}`);
    }
    if (response.correct && evidence.checks === 1 && evidence.firstCheckCorrect && !assistanceUsed && response.persistenceFailed) {
      return withOutcomeNotes('Correct on first check in this tab. Retained first-check evidence could not be confirmed.');
    }
    if (response.correct && assistanceUsed) {
      const missNote = evidence.checks && !evidence.firstCheckCorrect ? ' The original first check remains a miss.' : '';
      return withOutcomeNotes(`Correct now after assistance.${missNote} This correction remains activity, not first-check evidence.`);
    }
    if (response.correct && evidence.checks > 1 && !evidence.firstCheckCorrect) {
      return withOutcomeNotes('Correct now, but the first check was missed. This correction remains activity and does not replace the first result.');
    }
    if (response.correct && activityOnly) {
      return withOutcomeNotes('Correct now. This repeated item remains activity and does not add first-check evidence.');
    }
    if (response.correct) {
      return withOutcomeNotes('Correct now. This result remains activity rather than retained first-check evidence.');
    }
    if (response.revealedSteps) return withOutcomeNotes(`Method revealed. The answer is ${question.answer}; this remains assisted activity, not first-check evidence.`);
    if (response.revealedFinal) return withOutcomeNotes(`Answer revealed: ${question.answer}. This remains assisted activity, not first-check evidence.`);
    if (evidence.checks === 1 && !evidence.firstCheckCorrect && !assistanceUsed) {
      const evidenceNote = evidence.qualified
        ? 'A correction can build skill, but it will not replace this first-check result.'
        : 'This repeated or unsaved check remains activity rather than retained first-check evidence.';
      return withOutcomeNotes(`First check missed. ${evidenceNote}`);
    }
    return withOutcomeNotes('Not correct yet. Keep repairing the answer; this retry remains activity.');
  };

  const verifyCurrentAnswer = ({ renderResult = true } = {}) => {
    if (!currentSession || currentSession.completed) return false;
    const question = currentSession.questions[currentSession.currentIndex];
    const currentResponse = responseForCurrent();
    const input = byId('answer-input').value.trim();
    const feedback = feedbackForCurrent();
    if (!input) {
      feedback.hidden = false;
      feedback.textContent = 'Write your response first, or choose to reveal the answer or method.';
      return false;
    }
    const numericInput = Number(input);
    const answerTarget = currentResponse.recoveryMode && currentResponse.recoveryAnswer !== null
      ? currentResponse.recoveryAnswer
      : question.answer;
    const correct = input !== '' && !Number.isNaN(numericInput) && numericInput === answerTarget;
    const evidence = appendQuestionEvidence(currentSession.currentIndex, currentResponse, { kind: 'submit', value: input, correct });
    updateCurrentResponse({
      input,
      verified: true,
      correct,
      attempts: (currentResponse.attempts || 0) + 1,
      recoveryUsed: currentResponse.recoveryUsed || currentResponse.recoveryMode,
      recoveryMode: correct ? false : currentResponse.recoveryMode,
      evidence,
    });
    feedback.hidden = false;
    playTone(correct ? 'success' : 'error');
    if (!correct) {
      const recovery = currentResponse.recoveryPrompt ? currentResponse : buildRecoveryPrompt(question, currentSession.level, input);
      updateCurrentResponse({
        recoveryPrompt: recovery.recoveryPrompt || recovery.prompt,
        recoveryAnswer: recovery.recoveryAnswer ?? recovery.answer,
        recoveryMode: currentResponse.recoveryMode,
      });
    }

    if (correct && (currentSession.checkMode === 'final' || currentSession.checkMode === 'steps')) {
      updateCurrentResponse({ reviewedFinalAfterCheck: true });
    }
    if (correct && currentSession.checkMode === 'steps') {
      updateCurrentResponse({ reviewedStepsAfterCheck: true });
    }
    if (renderResult || !correct) renderSession();
    return correct;
  };

  const renderVisual = (value) => {
    const mount = byId('visual-mount');
    mount.replaceChildren();
    if (value === undefined || value === null) {
      mount.hidden = true;
      mount.removeAttribute('role');
      mount.removeAttribute('aria-label');
      return;
    }
    mount.setAttribute('role', 'img');
    mount.setAttribute('aria-label', `Soroban rods showing ${value}.`);
    const board = document.createElement('div');
    board.className = 'soroban-board';
    board.setAttribute('aria-hidden', 'true');
    String(value).split('').forEach((digitText) => {
      const digit = Number(digitText);
      const rod = document.createElement('div');
      rod.className = 'rod';
      const upper = document.createElement('div');
      upper.className = `bead upper ${digit >= 5 ? 'active' : ''}`;
      rod.appendChild(upper);
      const beam = document.createElement('div');
      beam.className = 'beam';
      rod.appendChild(beam);
      Array.from({ length: 4 }, (_, index) => {
        const bead = document.createElement('div');
        bead.className = `bead lower ${index < digit % 5 ? 'active' : ''}`;
        rod.appendChild(bead);
      });
      board.appendChild(rod);
    });
    mount.appendChild(board);
    mount.hidden = false;
  };

  const renderHistory = () => {
    const historyList = byId('history-list');
    const historyBlock = byId('history-block');
    const sessions = readSessions();
    historyList.replaceChildren();
    if (!sessions.length) {
      const note = document.createElement('p');
      note.className = 'muted';
      note.textContent = 'No saved sessions yet. Start one quick warm-up and it will appear here for resume or replay.';
      historyList.appendChild(note);
      if (historyBlock) historyBlock.open = false;
      return;
    }
    if (historyBlock) historyBlock.open = true;
    sessions.forEach((session) => {
      const card = document.createElement('article');
      card.className = 'session-card';
      const title = document.createElement('strong');
      title.textContent = session.challengeTitle || session.challengeKey
        ? `Challenge · ${session.challengeTitle || session.challengeKey}`
        : session.journeyTitle
          ? `Journey · ${session.journeyTitle}`
          : session.skill
            ? `${session.skill.replace(/-/g, ' ')} · ${session.level}`
            : `${session.type === 'curated' ? 'Curated' : 'Generated'} · ${session.level}`;
      const meta = document.createElement('p');
      meta.className = 'muted small';
      meta.textContent = `${session.id} · ${session.completed ? session.questions.length : session.currentIndex}/${session.questions.length} complete`;
      const score = document.createElement('div');
      score.className = 'score-band';
      score.textContent = session.challengeUnavailable
        ? 'Result unavailable for this saved rule version'
        : session.completed
        ? `${session.finalScore}/100${session.challengeOutcome ? ` · ${formatChallengeOutcome(session.challengeOutcome)}` : ''}`
        : 'In progress';
      const profile = document.createElement('p');
      profile.className = 'muted small';
      profile.textContent = session.challengeTitle || session.challengeKey
        ? session.challengeUnavailable
          ? 'Saved challenge rule is unavailable; record preserved without re-scoring.'
          : `Target: ${session.challengeTarget}`
        : session.journeyTitle
          ? `${session.journeyTitle} mode`
          : session.worksheetProfile
            ? buildWorksheetProfileLabel(session.worksheetProfile)
            : 'Lesson-aligned profile';
      const actions = document.createElement('div');
      actions.className = 'button-row';
      const viewable = normalizeViewablePracticeSession(session);
      const resumable = normalizeResumablePracticeSession(session);
      const completedView = viewable?.completed === true;
      const resume = document.createElement('button');
      resume.className = 'button button-secondary';
      resume.textContent = completedView ? 'Review result' : 'Resume';
      resume.setAttribute('aria-label', `${completedView ? 'Review result for' : 'Resume'} ${title.textContent} session ${session.id}`);
      if (resumable || completedView) {
        resume.addEventListener('click', () => {
          stopTimer();
          currentSession = resumable || viewable;
          syncControlsFromSession(currentSession);
          renderSession();
          focusCurrentQuestion();
        });
      } else {
        resume.disabled = true;
        resume.textContent = 'Resume unavailable';
        resume.setAttribute('aria-label', `Resume unavailable for ${title.textContent} session ${session.id}`);
      }
      const replay = document.createElement('button');
      replay.className = 'button button-secondary';
      replay.textContent = 'Replay list';
      replay.setAttribute('aria-label', `Replay ${title.textContent} session ${session.id}`);
      if (viewable) replay.addEventListener('click', () => replaySession(viewable));
      else {
        replay.disabled = true;
        replay.textContent = 'Replay unavailable';
        replay.setAttribute('aria-label', `Replay unavailable for ${title.textContent} session ${session.id}`);
      }
      if (session.challengeUnavailable) {
        profile.textContent = 'Saved rule version is unsupported; record preserved without re-scoring.';
      }
      actions.append(resume, replay);
      card.append(title, meta, profile, score, actions);
      historyList.appendChild(card);
    });
  };

  const renderSession = () => {
    const title = byId('session-title');
    const sessionIdLabel = byId('session-id');
    const progress = byId('session-progress');
    const score = byId('session-score');
    const timer = byId('session-timer');
    const adaptiveNote = byId('session-adaptive-note');
    const profile = byId('session-profile');
    const challengeSummary = byId('session-challenge-summary');
    const challengeCopy = byId('session-challenge-copy');
    const singleCompleteActions = byId('session-complete-actions');
    const sheetCompleteActions = byId('sheet-session-complete-actions');
    const questionTitle = byId('question-title');
    const questionPrompt = byId('question-prompt');
    const questionStatus = byId('practice-question-status');
    const questionLedger = byId('question-ledger');
    const answerInput = byId('answer-input');
    const singleFeedback = byId('feedback-panel');
    const sheetFeedback = byId('sheet-feedback-panel');
    let feedback = singleFeedback;
    const stepsPanel = byId('steps-panel');
    const recoveryPanel = byId('recovery-panel');
    const recoveryTitle = byId('recovery-title');
    const recoveryCopy = byId('recovery-copy');
    const leaveRecovery = byId('leave-recovery-prompt');
    const singleView = byId('single-session-view');
    const sheetView = byId('sheet-session-view');
    const sheetList = byId('sheet-list');
    const emptyNote = byId('practice-empty-note');
    const intentFeedback = byId('practice-intent-feedback');
    const sessionContext = byId('practice-session-context');
    const singleSessionActive = byId('single-session-active');
    const sessionHelp = byId('practice-session-help');
    const continuityRecommendation = root?.querySelector('[data-continuity-next-action]');
    const controls = ['answer-input', 'verify-answer', 'reveal-final', 'reveal-steps', 'next-question'];
    singleFeedback.hidden = true;
    sheetFeedback.hidden = true;
    if (intentFeedback) intentFeedback.hidden = true;
    singleCompleteActions.hidden = true;
    sheetCompleteActions.hidden = true;
    stepsPanel.hidden = true;
    if (recoveryPanel) recoveryPanel.hidden = true;
    sessionContext.hidden = !currentSession;
    singleSessionActive.hidden = !currentSession;
    sessionHelp.hidden = !currentSession;
    if (continuityRecommendation) continuityRecommendation.hidden = Boolean(currentSession);

    if (!currentSession) {
      title.textContent = 'No session selected yet';
      sessionIdLabel.textContent = '—';
      progress.textContent = 'Question 0 / 0';
      score.textContent = 'Accuracy —';
      timer.textContent = 'Timer off';
      adaptiveNote.textContent = '—';
      profile.textContent = 'Profile —';
      if (challengeSummary) challengeSummary.hidden = true;
      if (challengeCopy) challengeCopy.textContent = '—';
      questionTitle.textContent = 'Choose a session to begin.';
      questionPrompt.textContent = 'Curated lists follow the lessons; generated lists create replayable arithmetic practice.';
      questionStatus.textContent = '';
      questionLedger.hidden = true;
      questionLedger.textContent = '';
      answerInput.value = '';
      singleView.hidden = false;
      sheetView.hidden = true;
      emptyNote.hidden = false;
      renderVisual(null);
      controls.forEach((id) => { const node = byId(id); if (node) node.disabled = true; });
      activeTimerKey = null;
      return;
    }

    const question = currentSession.questions[currentSession.currentIndex];
    const response = responseForCurrent();
    title.textContent = currentSession.challengeTitle
      ? `${currentSession.challengeTitle} challenge`
      : currentSession.journeyTitle
        ? `${currentSession.journeyTitle} journey`
        : currentSession.skill
          ? `${currentSession.skill.replace(/-/g, ' ')} · ${currentSession.level} session`
          : `${currentSession.type === 'curated' ? 'Curated' : 'Generated'} ${currentSession.level} session`;
    sessionIdLabel.textContent = currentSession.id;
    progress.textContent = `Question ${currentSession.currentIndex + 1} / ${currentSession.questions.length}`;
    score.textContent = `Accuracy ${(currentSession.completed ? currentSession.finalScore : computeSessionScore(currentSession)) || 0}/100`;
    timer.textContent = currentSession.timerEnabled ? 'Timer on' : 'Timer off';
    adaptiveNote.textContent = currentSession.challengeTitle
      ? (currentSession.challengeOutcome ? formatChallengeOutcome(currentSession.challengeOutcome) : currentSession.challengeTarget)
      : currentSession.journeyTitle
        ? `${currentSession.journeyTitle} path`
        : currentSession.questionStyle === 'adaptive'
          ? describeAdaptivePractice(currentSession)
          : currentSession.skill
            ? `Focused skill: ${currentSession.skill.replace(/-/g, ' ')}`
            : 'Standard session';
    profile.textContent = currentSession.challengeTitle
      ? `Rule: ${currentSession.challengeRule}`
      : currentSession.journeyTitle
        ? `Profile ${currentSession.journeyTitle} mode`
        : `Profile ${currentSession.worksheetProfile ? buildWorksheetProfileLabel(currentSession.worksheetProfile) : 'Lesson-aligned'}`;
    if (challengeSummary && challengeCopy) {
      challengeSummary.hidden = !currentSession.challengeTitle;
      challengeCopy.textContent = currentSession.challengeOutcome
        ? formatChallengeOutcome(currentSession.challengeOutcome)
        : currentSession.challengeTarget || '—';
    }
    questionTitle.textContent = currentSession.completed
      ? 'Session completed'
      : response.recoveryMode && response.recoveryPrompt
        ? 'Recovery prompt'
        : question.title;
    questionPrompt.textContent = currentSession.completed
      ? `${currentSession.challengeOutcome ? `${formatChallengeOutcome(currentSession.challengeOutcome)}. ` : ''}Review your accuracy and first-check evidence, replay the same list, or start fresh.`
      : response.recoveryMode && response.recoveryPrompt
        ? response.recoveryPrompt
        : question.prompt;
    if (currentSession.completed) questionStatus.textContent = '';
    questionLedger.hidden = !question.promptLines?.length || currentSession.completed;
    questionLedger.textContent = question.promptLines?.join('\n') || '';
    answerInput.value = response.input || '';
    const isSheetMode = currentSession.format === 'sheet';
    feedback = isSheetMode ? sheetFeedback : singleFeedback;
    singleCompleteActions.hidden = isSheetMode || !currentSession.completed;
    sheetCompleteActions.hidden = !isSheetMode || !currentSession.completed;
    singleView.hidden = isSheetMode;
    sheetView.hidden = !isSheetMode;
    emptyNote.hidden = currentSession !== null;
    controls.forEach((id) => { const node = byId(id); if (node) node.disabled = currentSession.completed; });
    ['check-sheet', 'save-sheet'].forEach((id) => {
      const node = byId(id);
      if (node) node.disabled = currentSession.completed;
    });
    const showVisual = !isSheetMode && String(currentSession.questionStyle || '').includes('visual');
    renderVisual(showVisual ? question.visualValue : null);

    if (isSheetMode) {
      sheetList.replaceChildren();
      currentSession.questions.forEach((entry, index) => {
        const row = document.createElement('div');
        row.className = 'sheet-row';
        const prompt = document.createElement('div');
        prompt.className = 'sheet-prompt';
        const number = document.createElement('strong');
        number.textContent = `${index + 1}. `;
        const promptText = document.createTextNode(String(entry.prompt || 'Practice question'));
        prompt.append(number, promptText);
        const input = document.createElement('input');
        input.className = 'input';
        input.type = 'text';
        input.inputMode = 'numeric';
        input.placeholder = 'Answer';
        input.disabled = currentSession.completed;
        input.setAttribute('aria-label', `Answer for question ${index + 1}: ${entry.prompt || 'practice question'}`);
        input.value = currentSession.responses[index]?.input || '';
        input.addEventListener('input', () => {
          currentSession.responses[index] = {
            ...(currentSession.responses[index] || {}),
            input: input.value,
          };
          persistCurrent();
        });
        row.append(prompt, input);
        sheetList.appendChild(row);
      });
    }

    if (currentSession.timerEnabled && !currentSession.completed) {
      const nextTimerKey = `${currentSession.id}:${currentSession.currentIndex}`;
      if (activeTimerKey !== nextTimerKey) {
        if (timerInterval) window.clearInterval(timerInterval);
        const carriedSeconds = response.seconds || 0;
        questionStartedAt = Date.now() - (carriedSeconds * 1000);
        activeTimerKey = nextTimerKey;
        timerInterval = window.setInterval(() => {
          const seconds = Math.round((Date.now() - questionStartedAt) / 1000);
          timer.textContent = `Timer ${seconds}s`;
        }, 1000);
      }
    } else {
      if (timerInterval) window.clearInterval(timerInterval);
      timerInterval = null;
      questionStartedAt = null;
      activeTimerKey = null;
      if (currentSession.completed) {
        timer.textContent = 'Session complete';
      }
    }

    if (response.verified) {
      feedback.hidden = false;
      feedback.textContent = verificationFeedback(response, question);
    }
    if (response.revealedSteps || response.reviewedStepsAfterCheck) {
      stepsPanel.hidden = false;
      stepsPanel.replaceChildren();
      const list = document.createElement('ol');
      question.steps.forEach((step) => {
        const item = document.createElement('li');
        item.textContent = step;
        list.appendChild(item);
      });
      stepsPanel.appendChild(list);
    }
    if (!currentSession.completed && response.recoveryPrompt && (response.recoveryMode || (response.verified && !response.correct)) && recoveryPanel && recoveryTitle && recoveryCopy && leaveRecovery) {
      recoveryPanel.hidden = false;
      recoveryTitle.textContent = response.recoveryMode ? 'Repair prompt active' : 'Repair the pattern calmly';
      recoveryCopy.textContent = response.recoveryMode
        ? `${response.recoveryPrompt} Use the same answer box, then verify again.`
        : `Misses are part of the craft. Switch to this calmer repair prompt: ${response.recoveryPrompt}`;
      leaveRecovery.hidden = !response.recoveryMode;
    }
    persistCurrent();
    renderHistory();
  };

  const updateCurrentResponse = (next) => {
    if (!currentSession) return false;
    currentSession.responses[currentSession.currentIndex] = {
      ...responseForCurrent(),
      ...next,
    };
    const evidenceSaved = next.evidence ? persistQuestionEvidence(currentSession.currentIndex) : true;
    const sessionSaved = persistCurrent();
    if (!evidenceSaved || !sessionSaved) currentSession.responses[currentSession.currentIndex].persistenceFailed = true;
    return evidenceSaved && sessionSaved;
  };

  const completeCurrentSession = ({ finalScore = null, message }) => {
    if (!currentSession || currentSession.completed) return;
    currentSession.finalScore = finalScore ?? computeSessionScore(currentSession);
    currentSession.completed = true;
    currentSession.challengeOutcome = currentSession.challengeKey
      ? evaluateChallengeOutcome({
        challengeKey: currentSession.challengeKey,
        questions: currentSession.questions,
        responses: currentSession.responses,
        ruleVersion: currentSession.challengeRuleVersion,
      })
      : null;
    const sessionSaved = persistCurrent();
    renderSession();
    const feedback = feedbackForCurrent();
    feedback.hidden = false;
    const evidenceSummaries = currentSession.questions.map((_, index) => (
      summarizeAttemptEvidence(currentSession.responses[index]?.evidence)
    ));
    const evidenceSamples = evidenceSummaries.filter((summary) => summary.qualified).length;
    const evidenceCorrect = evidenceSummaries.filter((summary) => summary.qualified && summary.firstCheckCorrect).length;
    feedback.textContent = `${message} Final accuracy including corrections: ${currentSession.finalScore}/100. Qualified first-check samples: ${evidenceSamples}/${currentSession.questions.length}; first-check correct: ${evidenceCorrect}/${evidenceSamples || 0}.${currentSession.challengeOutcome ? ` ${formatChallengeOutcome(currentSession.challengeOutcome)}.` : ''}${sessionSaved ? '' : ' This session remains in this tab but was not saved to history.'} Replay the same list or start fresh when you are ready.`;
    renderHistory();
    window.requestAnimationFrame(() => {
      feedback.focus({ preventScroll: true });
      feedback.scrollIntoView({ block: 'center', behavior: 'auto' });
    });
  };

  const advanceCurrentQuestion = ({ announcementPrefix = '' } = {}) => {
    if (!currentSession || currentSession.completed) return false;
    stopTimer();
    const currentResponse = responseForCurrent();
    const input = byId('answer-input').value.trim();
    updateCurrentResponse(preparePracticeResponseForAdvance(currentResponse, input));
    if (currentSession.currentIndex < currentSession.questions.length - 1) {
      syncExerciseProgress();
      currentSession.currentIndex += 1;
      renderSession();
      focusCurrentQuestion();
      announceCurrentQuestion(announcementPrefix);
      return true;
    }
    syncExerciseProgress();
    completeCurrentSession({ message: 'Session complete.' });
    return false;
  };

  byId('start-session')?.addEventListener('click', () => {
    stopTimer();
    try {
      const nextSession = createSession({
        type: byId('session-type').value,
        level: byId('session-level').value,
        length: Number(byId('session-length').value),
        checkMode: byId('check-mode').value,
        timerEnabled: byId('timer-mode').value === 'on',
        format: byId('session-format').value,
        questionStyle: byId('question-style').value,
        termCount: byId('term-count').value,
        journeyKey: selectedJourneyKey,
        skill: selectedSkillKey,
        challengeKey: selectedChallengeKey,
      });
      currentSession = nextSession;
    } catch (error) {
      const feedback = feedbackForCurrent();
      feedback.hidden = false;
      feedback.textContent = 'This session could not be certified. Choose the mode again and retry.';
      console.error(error);
      return;
    }
    persistCurrent();
    renderSession();
    focusCurrentQuestion();
  });

  byId('resume-latest')?.addEventListener('click', () => {
    stopTimer();
    const candidate = readSessions()[0];
    if (!candidate) return;
    const latest = normalizeResumablePracticeSession(candidate);
    if (!latest) {
      const feedback = feedbackForCurrent();
      feedback.hidden = false;
      feedback.textContent = candidate.challengeUnavailable
        ? 'The latest saved challenge uses an unsupported rule version. Its record remains in history, but it cannot be resumed.'
        : candidate.completed === true
          ? 'The latest saved session is complete. Use saved sessions to review its result or replay the list.'
          : 'The latest saved session is incomplete or malformed and cannot be resumed safely.';
      return;
    }
    currentSession = latest;
    syncControlsFromSession(latest);
    renderSession();
    focusCurrentQuestion();
  });

  byId('session-level')?.addEventListener('change', (event) => {
    selectedSkillKey = null;
    selectedChallengeKey = null;
    applyPracticeLevelDefaults(event.target.value);
    syncPracticeSetupCopy();
  });

  byId('resume-by-id')?.addEventListener('click', () => {
    stopTimer();
    const requestedId = byId('session-id-input').value.trim();
    if (!requestedId) return;
    const candidate = readSessions().find((entry) => entry.id === requestedId);
    const match = normalizeResumablePracticeSession(candidate);
    const feedback = feedbackForCurrent();
    if (!candidate) {
      feedback.hidden = false;
      feedback.textContent = 'No saved session matched that ID on this device.';
      return;
    }
    if (!match) {
      feedback.hidden = false;
      feedback.textContent = candidate.challengeUnavailable
        ? 'That saved challenge uses an unsupported rule version. Its record remains in history, but it cannot be resumed.'
        : candidate.completed === true
          ? 'That saved session is complete. Use saved sessions to review its result or replay the list.'
          : 'That saved session is incomplete or malformed and cannot be resumed safely.';
      return;
    }
    currentSession = match;
    syncControlsFromSession(match);
    renderSession();
    focusCurrentQuestion();
  });

  byId('verify-answer')?.addEventListener('click', () => {
    verifyCurrentAnswer();
  });
  byId('answer-input')?.addEventListener('keydown', (event) => {
    if (applyWriteCellShortcut(event)) return;
    if (event.key !== 'Enter') return;
    event.preventDefault();
    const question = currentSession?.questions?.[currentSession.currentIndex];
    if (verifyCurrentAnswer({ renderResult: false }) && question) {
      advanceCurrentQuestion({ announcementPrefix: verificationFeedback(responseForCurrent(), question) });
    }
  });

  byId('reveal-final')?.addEventListener('click', () => {
    if (!currentSession || currentSession.completed) return;
    const response = responseForCurrent();
    updateCurrentResponse({
      revealedFinal: true,
      verified: true,
      correct: response.correct || false,
      input: byId('answer-input').value.trim(),
      evidence: appendQuestionEvidence(currentSession.currentIndex, response, { kind: 'reveal-final' }),
    });
    renderSession();
  });

  byId('reveal-steps')?.addEventListener('click', () => {
    if (!currentSession || currentSession.completed) return;
    const response = responseForCurrent();
    let evidence = appendQuestionEvidence(currentSession.currentIndex, response, { kind: 'reveal-final' });
    evidence = appendEvidenceEvent(evidence, { kind: 'reveal-steps' });
    updateCurrentResponse({ revealedSteps: true, revealedFinal: true, verified: true, correct: response.correct || false, input: byId('answer-input').value.trim(), evidence });
    renderSession();
  });
  byId('use-recovery-prompt')?.addEventListener('click', () => {
    const response = responseForCurrent();
    if (!response.recoveryPrompt) return;
    updateCurrentResponse({
      recoveryMode: true,
      recoveryUsed: true,
      verified: false,
      correct: false,
      input: '',
      evidence: appendQuestionEvidence(currentSession.currentIndex, response, { kind: 'recovery' }),
    });
    renderSession();
    byId('answer-input')?.focus();
  });
  byId('leave-recovery-prompt')?.addEventListener('click', () => {
    updateCurrentResponse({ recoveryMode: false, verified: false, input: '' });
    renderSession();
    byId('answer-input')?.focus();
  });
  byId('reveal-recovery-method')?.addEventListener('click', () => {
    byId('reveal-steps')?.click();
  });

  byId('next-question')?.addEventListener('click', () => advanceCurrentQuestion());
  document.querySelectorAll('.session-replay-current').forEach((button) => button.addEventListener('click', () => {
    if (!currentSession) return;
    replaySession(currentSession);
  }));
  document.querySelectorAll('.session-start-fresh').forEach((button) => button.addEventListener('click', () => {
    byId('start-session')?.click();
  }));

  byId('check-sheet')?.addEventListener('click', () => {
    if (!currentSession || currentSession.completed) return;
    let correctCount = 0;
    let saved = true;
    currentSession.questions.forEach((question, index) => {
      const input = currentSession.responses[index]?.input?.trim() || '';
      const correct = input !== '' && Number(input) === question.answer;
      const previous = currentSession.responses[index] || {};
      currentSession.responses[index] = {
        ...previous,
        input,
        verified: true,
        correct,
        attempts: (previous.attempts || 0) + 1,
        evidence: appendQuestionEvidence(index, previous, { kind: 'submit', value: input, correct }),
      };
      if (correct) correctCount += 1;
      if (!syncExerciseProgress(index)) saved = false;
    });
    playTone(correctCount === currentSession.questions.length ? 'success' : 'error');
    completeCurrentSession({
      finalScore: Math.round((correctCount / currentSession.questions.length) * 100),
      message: `Sheet checked. ${correctCount}/${currentSession.questions.length} correct.${saved ? '' : ' Some results remain in this tab but were not saved to Progress.'}`,
    });
  });

  byId('reveal-sheet-answers')?.addEventListener('click', () => {
    if (!currentSession) return;
    if (!currentSession.completed) {
      currentSession.questions.forEach((_, index) => {
        const previous = currentSession.responses[index] || {};
        currentSession.responses[index] = {
          ...previous,
          revealedFinal: true,
          evidence: appendQuestionEvidence(index, previous, { kind: 'reveal-final' }),
        };
        persistQuestionEvidence(index);
      });
      persistCurrent();
    }
    const stepsPanel = byId('steps-panel');
    stepsPanel.hidden = false;
    stepsPanel.replaceChildren();
    const list = document.createElement('ol');
    currentSession.questions.forEach((question) => {
      const item = document.createElement('li');
      item.textContent = `${question.prompt} → ${question.answer}`;
      list.appendChild(item);
    });
    stepsPanel.appendChild(list);
  });

  byId('save-sheet')?.addEventListener('click', () => {
    if (!currentSession) return;
    const saved = persistCurrent();
    const feedback = feedbackForCurrent();
    feedback.hidden = false;
    feedback.textContent = saved
      ? 'Sheet progress saved. You can return later and continue where you left off.'
      : 'Sheet progress remains in this tab, but browser storage did not save it for later.';
  });

  byId('print-sheet')?.addEventListener('click', () => window.print());

  document.querySelectorAll('[data-preset]').forEach((button) => {
    button.addEventListener('click', () => applyPreset(button.dataset.preset));
  });
  document.querySelectorAll('[data-journey]').forEach((button) => {
    if (button.classList.contains('practice-journey-start')) {
      button.addEventListener('click', () => startFromJourney(button.dataset.journey));
      return;
    }
    button.addEventListener('click', () => applyJourney(button.dataset.journey));
  });
  document.querySelectorAll('[data-challenge]').forEach((button) => {
    if (button.classList.contains('practice-challenge-start')) {
      button.addEventListener('click', () => startFromChallenge(button.dataset.challenge));
      return;
    }
    button.addEventListener('click', () => applyChallenge(button.dataset.challenge));
  });
  document.querySelectorAll('#session-format, #session-type, #session-level, #session-length, #check-mode, #question-style, #term-count, #timer-mode, #worksheet-digit-range, #worksheet-operation-range, #worksheet-operator-mode').forEach((node) => {
    node.addEventListener('change', () => {
      selectedChallengeKey = null;
      if (node.id === 'session-level' && selectedSkillKey) {
        const selectedTarget = targetForSkill(selectedSkillKey);
        if (selectedTarget?.level !== node.value) selectedSkillKey = null;
      }
      syncPracticeSetupCopy();
    });
  });

  renderPrimaryPracticeAction();
  window.addEventListener('soroban:storage-ready', renderPrimaryPracticeAction);
  window.addEventListener('soroban:learner-context-change', renderPrimaryPracticeAction);
  window.addEventListener('soroban:continuity-change', renderPrimaryPracticeAction);
  window.addEventListener('storage', (event) => {
    if (!event.key || event.key.startsWith('soroban-dojo:')) renderPrimaryPracticeAction();
  });
  renderHistory();
  const query = new URLSearchParams(window.location.search);
  const requestedResumeId = query.get('resume');
  const requestedLevel = String(query.get('level') || '').toUpperCase();
  const requestedSkill = String(query.get('skill') || '').toLowerCase();
  const supportedSkills = new Set(['addition', 'subtraction', 'complements', 'mixed-operations', 'multiplication', 'division', 'anzan', 'mastery', 'number-reading', 'number-setting', 'place-value', 'abacus-orientation']);
  const hasRequestedLevel = /^L[0-5]$/.test(requestedLevel);
  let resumedFromUrl = false;
  let resumeError = '';
  if (requestedResumeId !== null) {
    const candidate = readSessions().find((entry) => entry.id === requestedResumeId);
    const match = normalizeResumablePracticeSession(candidate);
    if (match && !match.challengeUnavailable) {
      currentSession = match;
      syncControlsFromSession(match);
      resumedFromUrl = true;
    } else {
      resumeError = candidate?.challengeUnavailable
        ? 'That saved challenge uses an unsupported rule version. Its record remains in history, but it cannot be resumed.'
        : candidate?.completed === true
          ? 'That saved session is already complete. Open saved sessions to replay it instead.'
          : candidate
            ? 'That saved session is incomplete or malformed and cannot be resumed safely.'
            : 'No saved session matched that exact ID on this device.';
    }
  } else if (hasRequestedLevel) {
    applyPreset('practice');
    const requestedTarget = supportedSkills.has(requestedSkill) ? targetForSkill(requestedSkill, requestedLevel) : null;
    const normalizedLevel = requestedTarget?.level || requestedLevel;
    selectedSkillKey = requestedTarget?.skill || null;
    byId('session-level').value = normalizedLevel;
    applyPracticeLevelDefaults(normalizedLevel);
    byId('session-type').value = 'generated';
    if (requestedTarget && (requestedLevel !== requestedTarget.level || requestedSkill !== requestedTarget.skill)) {
      query.set('level', requestedTarget.level);
      query.set('skill', requestedTarget.skill);
      window.history.replaceState({}, '', `${window.location.pathname}?${query.toString()}`);
    }
  } else {
    applyPracticeLevelDefaults(byId('session-level')?.value || 'L0');
  }
  syncPracticeSetupCopy();
  renderSession();
  if (resumeError) {
    const feedback = byId('practice-intent-feedback');
    if (feedback) {
      feedback.hidden = false;
      feedback.textContent = resumeError;
    }
  }
  if (resumedFromUrl) focusCurrentQuestion();
  else if (requestedResumeId === null && hasRequestedLevel && query.get('start') === '1') byId('start-session')?.click();
</script>

<style>
  .worksheet-ledger {
    margin: 0.75rem 0 0;
    padding: 0.9rem 1rem;
    border: 1px dashed color-mix(in srgb, var(--border) 78%, var(--panel-raised) 22%);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--panel-raised) 86%, var(--surface) 14%);
    color: var(--ink);
    font: 600 1.1rem/1.7 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    white-space: pre-wrap;
  }

  #feedback-panel:focus-visible,
  #sheet-feedback-panel:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  @media (max-width: 420px) {
    .session-complete-actions > * {
      width: 100%;
    }
  }
</style>
