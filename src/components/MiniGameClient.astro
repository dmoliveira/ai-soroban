---
import { MINI_GAME_LIST } from '../lib/mini-games.js';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section id="mini-games-panel" class="panel mini-games-panel">
  <div class="section-head">
    <div>
      <p class="eyebrow">Mini games</p>
      <h2>Play one complete round, then review the result</h2>
      <p class="muted">Every mode has a clear finish. Compare normalized results on a 0–100 scale while round points and streaks stay playful.</p>
    </div>
    <span class="badge">Finite, focused, replayable</span>
  </div>

  <div class="card-grid">
    {MINI_GAME_LIST.map((game) => (
      <article class="choice-card" data-mini-game-card={game.key}>
        <p class="eyebrow">Game</p>
        <h3>{game.title}</h3>
        <p>{game.summary}</p>
        <p class="muted small"><strong>Rule:</strong> {game.rule}</p>
        <div class="button-row button-row-compact">
          <button class="button button-secondary minigame-select" data-game={game.key} aria-pressed="false">Configure {game.title}</button>
        </div>
      </article>
    ))}
  </div>

  <div class="subtle-panel mini-game-summary">
    <h3 id="mini-game-title" tabindex="-1">Number Bond Blitz</h3>
    <p id="mini-game-copy" class="muted small">Complete number bonds in a finite accuracy sprint.</p>
    <div id="mini-game-best" class="muted small">No comparable result yet</div>
    <div id="mini-game-tier" class="muted small">Unlocked tier: starter</div>
    <div id="mini-game-medal" class="muted small">Medal targets will appear here.</div>
    <div id="mini-game-rule" class="muted small">Rule details will appear here.</div>

    <div class="mini-game-settings" aria-label="Mini-game session settings">
      <label class="stack-sm mini-game-setting" data-setting="question-count">
        <span>Questions</span>
        <select id="mini-game-question-count" class="select">
          <option value="5">5 questions</option>
          <option value="10" selected>10 questions</option>
          <option value="20">20 questions</option>
        </select>
      </label>
      <label class="stack-sm mini-game-setting" data-setting="time-limit">
        <span>Time limit</span>
        <select id="mini-game-time-limit" class="select">
          <option value="0">No time limit</option>
          <option value="15">15 seconds</option>
          <option value="30" selected>30 seconds</option>
          <option value="60">60 seconds</option>
        </select>
      </label>
      <label class="stack-sm mini-game-setting" data-setting="term-count" hidden>
        <span>Flash terms</span>
        <select id="mini-game-term-count" class="select">
          <option value="10">10 terms</option>
          <option value="20" selected>20 terms</option>
          <option value="30">30 terms</option>
        </select>
      </label>
      <label class="stack-sm mini-game-setting" data-setting="term-interval" hidden>
        <span>Time per term</span>
        <select id="mini-game-term-interval" class="select">
          <option value="500">0.5 seconds</option>
          <option value="1000" selected>1.0 second</option>
          <option value="1500">1.5 seconds</option>
          <option value="2000">2.0 seconds</option>
        </select>
      </label>
      <label class="stack-sm mini-tier-picker">
        <span>Difficulty tier</span>
        <select id="mini-game-difficulty" class="select">
          <option value="starter">Starter</option>
          <option value="bronze">Bronze</option>
          <option value="silver">Silver</option>
          <option value="gold">Gold</option>
        </select>
      </label>
    </div>

    <div id="mini-game-accessibility-note" class="subtle-panel muted small" hidden>
      Flash Anzan is an intentionally timed visual mode; its changing terms are not announced live.
      Prefer an untimed equivalent? <a class="text-link" href={`${base}practice?level=L5&skill=anzan`}>Open mental practice</a>.
    </div>

    <div class="button-row button-row-compact">
      <button class="button" id="mini-game-start-selected">Start selected game</button>
    </div>
  </div>

  <div class="subtle-panel mini-game-playfield">
    <div class="subtle-panel mini-game-prompt-panel">
      <strong id="mini-game-prompt-title">Prompt</strong>
      <p id="mini-game-term-counter" class="muted small" hidden>Term 0 / 20</p>
      <p id="mini-game-prompt" class="mini-game-prompt">Start the selected game to begin.</p>
      <label class="stack-sm" for="mini-game-answer">
        <span>Answer</span>
        <input id="mini-game-answer" class="input" type="text" inputmode="numeric" placeholder="Write your answer" disabled aria-disabled="true" />
      </label>
      <div class="button-row button-row-compact mini-game-controls">
        <button class="button button-secondary" id="mini-game-check" disabled aria-disabled="true">Check answer</button>
        <button class="button button-secondary" id="mini-game-stop" disabled aria-disabled="true">Stop session</button>
      </div>
      <p id="mini-game-feedback" class="muted small" role="status" aria-live="polite" aria-atomic="true">Choose a finite session, then start when you are ready.</p>
    </div>
    <div class="stats-grid mini-game-live-stats">
      <article class="stat-card stat-card-soft"><small>Round points</small><span id="mini-game-score">0</span></article>
      <article class="stat-card stat-card-soft"><small>Streak</small><span id="mini-game-streak">0</span></article>
      <article class="stat-card stat-card-soft"><small>Progress</small><span id="mini-game-progress">0 / 10</span></article>
      <article class="stat-card stat-card-soft"><small>Time</small><span id="mini-game-time">0:00</span></article>
    </div>

    <section id="mini-game-results" class="reveal-panel mini-game-results" role="status" aria-live="polite" aria-atomic="true" hidden>
      <p class="eyebrow">Session complete</p>
      <h3 id="mini-game-result-title" tabindex="-1">Round complete</h3>
      <p id="mini-game-result-reason" class="muted">Completion reason</p>
      <p class="mini-game-result-line">
        <strong>Comparable result <span id="mini-game-result-score">0</span>/100</strong>
        <span>Round points <strong id="mini-game-result-points">0</strong></span>
        <span>Accuracy <strong id="mini-game-result-accuracy">0 / 0</strong></span>
        <span>Time <strong id="mini-game-result-time">0:00</strong></span>
      </p>
      <button class="button" id="mini-game-play-again">Play Again</button>
    </section>
  </div>
</section>

<script>
  // @ts-nocheck
  import {
    MINI_GAME_DEFINITIONS,
    MINI_GAME_TIERS,
    buildMiniGameRound,
    createMiniGameState,
    miniGameElapsedMs,
    normalizeMiniGameSettings,
    reduceMiniGameState,
    shouldPersistMiniGameResult,
  } from '../lib/mini-games.js';
  import { buildScoreSummary, medalForNormalizedScore, normalizeScoreStore, scoreScopeKey, storeComparableScore } from '../lib/scoring.js';
  import { STORAGE_KEYS, readStoredJson, writeStoredJson } from '../lib/storage.js';
  import { ensureStorageCompatibility } from '../lib/storage-migrations.js';

  ensureStorageCompatibility(localStorage);

  const byId = (id) => document.getElementById(id);
  const activeStatuses = new Set(['running', 'awaiting-answer']);
  const settingsByGame = Object.fromEntries(Object.entries(MINI_GAME_DEFINITIONS).map(([gameId, definition]) => [
    gameId,
    { ...definition.defaults },
  ]));

  let currentGame = 'complement-dash';
  let currentTier = 'starter';
  let currentState = null;
  let runToken = 0;
  let completionHandledToken = null;
  let elapsedInterval = null;
  const pendingTimeouts = new Set();

  const readScoreStore = () => normalizeScoreStore(readStoredJson(localStorage, STORAGE_KEYS.miniGameScoresV2, {}));
  const isActive = () => currentState && activeStatuses.has(currentState.status);
  const formatTime = (milliseconds) => {
    const totalSeconds = Math.max(0, Math.floor(milliseconds / 1000));
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = String(totalSeconds % 60).padStart(2, '0');
    return `${minutes}:${seconds}`;
  };
  const makeSeed = () => `mini-${Date.now().toString(36)}-${runToken.toString(36)}`;

  const clearSchedulers = () => {
    if (elapsedInterval !== null) window.clearInterval(elapsedInterval);
    elapsedInterval = null;
    pendingTimeouts.forEach((timeoutId) => window.clearTimeout(timeoutId));
    pendingTimeouts.clear();
  };

  const scheduleTimeout = (callback, delay, token) => {
    const timeoutId = window.setTimeout(() => {
      pendingTimeouts.delete(timeoutId);
      if (token !== runToken) return;
      callback();
    }, delay);
    pendingTimeouts.add(timeoutId);
  };

  const syncTierPicker = () => {
    const definition = MINI_GAME_DEFINITIONS[currentGame];
    const scoreStore = readScoreStore();
    const legacyBest = Number(scoreStore.legacy.scores[currentGame]) || 0;
    const legacyMedal = scoreStore.legacy.medals[currentGame] || 'starter';
    const summaries = Object.values(scoreStore.bestByScope)
      .filter((summary) => summary.scope.mode === currentGame)
      .sort((left, right) => right.normalized - left.normalized);
    const normalizedMedal = medalForNormalizedScore(summaries[0]?.normalized || 0);
    const medal = normalizedMedal;
    const unlockedIndex = Math.max(0, MINI_GAME_TIERS.indexOf(medal));
    const picker = byId('mini-game-difficulty');
    [...picker.options].forEach((option, index) => { option.disabled = index > unlockedIndex; });
    if (MINI_GAME_TIERS.indexOf(currentTier) > unlockedIndex) currentTier = MINI_GAME_TIERS[unlockedIndex];
    picker.value = currentTier;
    const selectedScope = {
      mode: currentGame,
      tier: currentTier,
      ruleVersion: definition.ruleVersion,
      settings: normalizeMiniGameSettings(currentGame, settingsByGame[currentGame]),
    };
    const bestSummary = scoreStore.bestByScope[scoreScopeKey(selectedScope)] || null;
    return { bestSummary, legacyBest, legacyMedal, medal };
  };

  const syncSettings = () => {
    const settings = settingsByGame[currentGame];
    const definition = MINI_GAME_DEFINITIONS[currentGame];
    document.querySelector('[data-setting="question-count"]').hidden = definition.kind === 'flash';
    document.querySelector('[data-setting="time-limit"]').hidden = currentGame !== 'complement-dash';
    document.querySelector('[data-setting="term-count"]').hidden = definition.kind !== 'flash';
    document.querySelector('[data-setting="term-interval"]').hidden = definition.kind !== 'flash';
    if (settings.questionCount) byId('mini-game-question-count').value = String(settings.questionCount);
    if (settings.timeLimitSeconds !== undefined) byId('mini-game-time-limit').value = String(settings.timeLimitSeconds);
    if (settings.termCount) byId('mini-game-term-count').value = String(settings.termCount);
    if (settings.intervalMs) byId('mini-game-term-interval').value = String(settings.intervalMs);
    byId('mini-game-accessibility-note').hidden = definition.kind !== 'flash';
  };

  const syncGameMeta = () => {
    const definition = MINI_GAME_DEFINITIONS[currentGame];
    const { bestSummary, legacyBest, legacyMedal, medal } = syncTierPicker();
    byId('mini-game-title').textContent = definition.title;
    byId('mini-game-copy').textContent = definition.summary;
    byId('mini-game-best').textContent = bestSummary
      ? `Best comparable result: ${bestSummary.normalized}/100 · ${bestSummary.scope.tier}`
      : legacyBest
        ? `Legacy record only: ${legacyBest} points · ${legacyMedal} legacy medal · comparable tier progress starts with your next round`
        : 'No comparable result yet';
    byId('mini-game-tier').textContent = `Unlocked tier: ${medal}`;
    byId('mini-game-medal').textContent = 'Comparable medal targets: bronze 60, silver 80, gold 95';
    byId('mini-game-rule').textContent = `Rule: ${definition.rule}`;
    document.querySelectorAll('.minigame-select').forEach((button) => {
      const selected = button.dataset.game === currentGame;
      button.setAttribute('aria-pressed', String(selected));
      button.closest('[data-mini-game-card]')?.classList.toggle('selected', selected);
    });
    syncSettings();
  };

  const setControlState = () => {
    const active = isActive();
    const awaitingAnswer = currentState?.status === 'awaiting-answer';
    const flashRunning = currentGame === 'anzan-flash' && currentState?.status === 'running';
    const answerEnabled = active && !flashRunning;
    byId('mini-game-answer').disabled = !answerEnabled;
    byId('mini-game-answer').setAttribute('aria-disabled', String(!answerEnabled));
    byId('mini-game-check').disabled = !answerEnabled;
    byId('mini-game-check').setAttribute('aria-disabled', String(!answerEnabled));
    byId('mini-game-stop').disabled = !active;
    byId('mini-game-stop').setAttribute('aria-disabled', String(!active));
    byId('mini-game-start-selected').disabled = active;
    byId('mini-game-difficulty').disabled = active;
    document.querySelectorAll('.mini-game-setting select, .minigame-select').forEach((control) => {
      control.disabled = active;
    });
    if (awaitingAnswer) byId('mini-game-answer').removeAttribute('readonly');
  };

  const syncTime = () => {
    if (!currentState?.startedAt) {
      byId('mini-game-time').textContent = '0:00';
      return;
    }
    if (currentGame === 'complement-dash' && currentState.status !== 'complete' && currentState.deadlineAt !== null) {
      const remaining = Math.max(0, currentState.deadlineAt - Date.now());
      byId('mini-game-time').textContent = `${Math.ceil(remaining / 1000)}s left`;
      return;
    }
    byId('mini-game-time').textContent = formatTime(miniGameElapsedMs(currentState));
  };

  const renderPrompt = () => {
    const promptTitle = byId('mini-game-prompt-title');
    const prompt = byId('mini-game-prompt');
    const counter = byId('mini-game-term-counter');
    counter.hidden = true;
    if (!currentState || currentState.status === 'idle') {
      promptTitle.textContent = 'Prompt';
      prompt.textContent = 'Start the selected game to begin.';
      return;
    }
    if (currentState.status === 'complete') {
      promptTitle.textContent = 'Round complete';
      prompt.textContent = 'Review the score and elapsed time below, then choose Play Again when ready.';
      return;
    }
    if (currentGame === 'anzan-flash') {
      counter.hidden = false;
      counter.textContent = `Term ${currentState.termsShown} / ${currentState.round.terms.length}`;
      if (currentState.status === 'awaiting-answer') {
        promptTitle.textContent = 'Final total';
        prompt.textContent = 'What was the final total?';
        return;
      }
      const term = currentState.round.terms[currentState.termsShown - 1];
      promptTitle.textContent = 'Flash term';
      prompt.textContent = term.operator ? `${term.operator} ${term.value}` : String(term.value);
      return;
    }
    const question = currentState.round.questions[currentState.questionIndex];
    promptTitle.textContent = `${MINI_GAME_DEFINITIONS[currentGame].title} · question ${currentState.questionIndex + 1}`;
    prompt.textContent = question?.prompt || 'Round complete';
  };

  const renderState = () => {
    const state = currentState;
    byId('mini-game-score').textContent = String(state?.score || 0);
    byId('mini-game-streak').textContent = String(state?.streak || 0);
    if (!state) {
      const settings = settingsByGame[currentGame];
      const total = settings.questionCount || settings.termCount;
      byId('mini-game-progress').textContent = `0 / ${total}`;
    } else if (currentGame === 'anzan-flash') {
      byId('mini-game-progress').textContent = `${state.termsShown} / ${state.round.terms.length}`;
    } else {
      byId('mini-game-progress').textContent = `${state.answeredCount} / ${state.round.questions.length}`;
    }
    renderPrompt();
    syncTime();
    setControlState();
  };

  const persistCompletedResult = () => {
    if (!currentState || !shouldPersistMiniGameResult(currentState)) return null;
    const total = currentGame === 'anzan-flash' ? 1 : currentState.round.questions.length;
    const summary = buildScoreSummary({
      mode: currentGame,
      tier: currentState.round.tier,
      ruleVersion: currentState.round.ruleVersion || 1,
      settings: currentState.round.settings,
      rawPoints: currentState.score,
      correct: currentState.correctCount,
      answered: currentState.answeredCount,
      total,
      completedNaturally: true,
      completedAt: new Date(currentState.completedAt).toISOString(),
    });
    const scoreStore = readScoreStore();
    const saved = writeStoredJson(localStorage, STORAGE_KEYS.miniGameScoresV2, storeComparableScore(scoreStore, summary));
    return { summary, saved };
  };

  const completionReason = (state) => ({
    'questions-complete': 'You reached the end of the question list.',
    'time-expired': 'The time limit ended the session.',
    'answer-submitted': 'Your final Flash Anzan answer completed the session.',
    stopped: 'You stopped the session. This partial score was not saved as a best.',
    interrupted: 'The page became hidden, so the session stopped safely without saving a best.',
  })[state.reason] || 'The session ended.';

  const handleCompletion = () => {
    if (currentState?.status !== 'complete' || completionHandledToken === runToken) return;
    completionHandledToken = runToken;
    clearSchedulers();
    const persisted = persistCompletedResult();
    const total = currentGame === 'anzan-flash' ? 1 : currentState.round.questions.length;
    const resultSummary = persisted?.summary || buildScoreSummary({
      mode: currentGame,
      tier: currentState.round.tier,
      ruleVersion: currentState.round.ruleVersion || 1,
      settings: currentState.round.settings,
      rawPoints: currentState.score,
      correct: currentState.correctCount,
      answered: currentState.answeredCount,
      total,
      completedNaturally: false,
    });
    const results = byId('mini-game-results');
    const resultTitle = byId('mini-game-result-title');
    resultTitle.textContent = `${MINI_GAME_DEFINITIONS[currentGame].title} complete`;
    byId('mini-game-result-reason').textContent = `${completionReason(currentState)}${persisted && !persisted.saved ? ' This result is available in this tab, but browser storage did not save it as a best.' : ''}`;
    byId('mini-game-result-score').textContent = String(resultSummary.normalized);
    byId('mini-game-result-points').textContent = String(currentState.score);
    byId('mini-game-result-accuracy').textContent = currentGame === 'anzan-flash' && currentState.reason !== 'answer-submitted'
      ? `${currentState.termsShown}/${currentState.round.terms.length} terms shown`
      : `${currentState.correctCount} / ${currentState.answeredCount}`;
    byId('mini-game-result-time').textContent = formatTime(miniGameElapsedMs(currentState));
    results.hidden = false;
    syncGameMeta();
    renderState();
    window.requestAnimationFrame(() => {
      resultTitle.focus({ preventScroll: true });
      resultTitle.scrollIntoView({ block: 'start', behavior: 'auto' });
    });
  };

  const dispatch = (event) => {
    if (!currentState) return;
    currentState = reduceMiniGameState(currentState, { ...event, now: event.now ?? Date.now() });
    renderState();
    handleCompletion();
  };

  const scheduleFlash = (token) => {
    if (!currentState || currentState.gameId !== 'anzan-flash' || currentState.status !== 'running') return;
    scheduleTimeout(() => {
      if (!currentState || token !== runToken || currentState.status !== 'running') return;
      if (currentState.termsShown < currentState.round.terms.length) {
        dispatch({ type: 'SHOW_FLASH_TERM' });
        scheduleFlash(token);
        return;
      }
      dispatch({ type: 'FLASH_READY' });
      byId('mini-game-feedback').textContent = 'The full sequence is complete. Enter the final total once.';
      byId('mini-game-answer').focus();
    }, currentState.round.settings.intervalMs, token);
  };

  const startGame = (gameId = currentGame) => {
    clearSchedulers();
    runToken += 1;
    completionHandledToken = null;
    currentGame = gameId;
    const settings = normalizeMiniGameSettings(currentGame, settingsByGame[currentGame]);
    settingsByGame[currentGame] = settings;
    const round = buildMiniGameRound({
      gameId: currentGame,
      tier: currentTier,
      settings,
      seed: makeSeed(),
    });
    currentState = reduceMiniGameState(createMiniGameState(round), { type: 'START', now: Date.now() });
    byId('mini-game-answer').value = '';
    byId('mini-game-results').hidden = true;
    byId('mini-game-feedback').textContent = currentGame === 'anzan-flash'
      ? 'Watch each visual term. Terms are not live-announced; Stop remains available throughout the sequence.'
      : 'Submit one numeric answer for each prompt. Wrong answers still consume the question.';
    syncGameMeta();
    renderState();

    if (currentGame === 'anzan-flash') byId('mini-game-stop').focus();
    else byId('mini-game-answer').focus();
    const token = runToken;
    elapsedInterval = window.setInterval(() => {
      if (token !== runToken || !currentState || !isActive()) return;
      dispatch({ type: 'TICK' });
    }, 250);
    if (currentGame === 'anzan-flash') scheduleFlash(token);
  };

  const selectGame = (gameId, focusSummary = true) => {
    if (isActive() || !MINI_GAME_DEFINITIONS[gameId]) return;
    clearSchedulers();
    currentGame = gameId;
    currentState = null;
    completionHandledToken = null;
    byId('mini-game-results').hidden = true;
    byId('mini-game-answer').value = '';
    byId('mini-game-feedback').textContent = 'Review the finite session settings, then start when ready.';
    syncGameMeta();
    renderState();
    if (focusSummary) {
      window.requestAnimationFrame(() => {
        const title = byId('mini-game-title');
        title.focus({ preventScroll: true });
        title.scrollIntoView({ block: 'start', behavior: 'auto' });
      });
    }
  };

  const submitAnswer = () => {
    if (!isActive()) return;
    const input = byId('mini-game-answer').value.trim();
    if (!input || !Number.isFinite(Number(input))) {
      byId('mini-game-feedback').textContent = 'Write a numeric answer first.';
      return;
    }
    const previous = currentState;
    const previousQuestion = previous.gameId === 'anzan-flash' ? null : previous.round.questions[previous.questionIndex];
    dispatch({ type: 'SUBMIT', input, questionIndex: previous.questionIndex });
    if (currentState === previous) return;
    if (currentState.status !== 'complete') {
      byId('mini-game-feedback').textContent = currentState.lastAnswerCorrect
        ? 'Correct. The next prompt is ready.'
        : `Not correct. The answer was ${previousQuestion.answer}; the next prompt is ready.`;
      byId('mini-game-answer').value = '';
      byId('mini-game-answer').focus();
    }
  };

  document.querySelectorAll('.minigame-select').forEach((button) => button.addEventListener('click', () => selectGame(button.dataset.game)));
  byId('mini-game-start-selected')?.addEventListener('click', () => startGame());
  byId('mini-game-check')?.addEventListener('click', submitAnswer);
  byId('mini-game-stop')?.addEventListener('click', () => dispatch({ type: 'STOP', reason: 'stopped' }));
  byId('mini-game-play-again')?.addEventListener('click', () => startGame());
  byId('mini-game-answer')?.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    submitAnswer();
  });
  byId('mini-game-difficulty')?.addEventListener('change', (event) => {
    if (isActive()) return;
    currentTier = event.target.value;
    syncGameMeta();
  });
  const settingsControls = {
    'mini-game-question-count': 'questionCount',
    'mini-game-time-limit': 'timeLimitSeconds',
    'mini-game-term-count': 'termCount',
    'mini-game-term-interval': 'intervalMs',
  };
  Object.entries(settingsControls).forEach(([id, key]) => byId(id)?.addEventListener('change', (event) => {
    if (isActive()) return;
    settingsByGame[currentGame] = normalizeMiniGameSettings(currentGame, {
      ...settingsByGame[currentGame],
      [key]: Number(event.target.value),
    });
    syncGameMeta();
    renderState();
  }));
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && isActive()) dispatch({ type: 'STOP', reason: 'interrupted' });
  });

  syncGameMeta();
  renderState();
</script>

<style>
  .mini-game-settings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.75rem;
    margin-block: 1rem;
  }

  [data-mini-game-card].selected {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  #mini-game-title {
    margin: 0;
    scroll-margin-top: 1rem;
  }

  .mini-game-prompt {
    min-height: 3rem;
    font-size: clamp(1.25rem, 4vw, 2rem);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .mini-game-results {
    margin-top: 1rem;
    scroll-margin-top: 1rem;
  }

  .mini-game-result-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
  }

  #mini-game-title:focus-visible,
  #mini-game-result-title:focus-visible {
    outline: 3px solid var(--accent);
