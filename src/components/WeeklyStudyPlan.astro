---
interface LessonEntry {
  id: string;
  title: string;
  slug: string;
  skill: string;
  level: string;
}

interface ExerciseEntry {
  id: string;
  title: string;
  slug: string;
  skill: string;
  level: string;
}

interface Props {
  lessons: LessonEntry[];
  exercises: ExerciseEntry[];
}

const { lessons, exercises } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<section class="panel weekly-plan-panel" data-base={base} data-lessons={JSON.stringify(lessons)} data-exercises={JSON.stringify(exercises)}>
  <div class="section-head">
    <div>
      <p class="eyebrow">Weekly plan</p>
      <h2>Your next 7 days</h2>
      <p class="muted">A practical route through one lesson, one exercise, and one worksheet at a time, based on your saved route, placement, and retained review signals.</p>
    </div>
  </div>

  <div class="subtle-panel weekly-plan-summary">
    <strong id="weekly-plan-title">Calm weekly path</strong>
    <p id="weekly-plan-copy" class="muted">The plan will adapt as you complete lessons and add first-check answers or saved review items.</p>
  </div>

  <div id="weekly-plan-current" aria-live="polite"></div>
  <section class="panel weekly-plan-rest-panel">
    <div class="section-head">
      <div>
        <p class="eyebrow">Rest of this week</p>
        <h3>Keep the remaining steps light</h3>
      </div>
      <p class="muted">Once the current step is done, continue in order instead of opening every route at once.</p>
    </div>
    <div class="weekly-plan-grid" id="weekly-plan-grid"></div>
  </section>
</section>

<style>
  .weekly-plan-current-card{display:grid;gap:1rem;margin-top:1rem;background:linear-gradient(180deg, color-mix(in srgb, var(--panel-raised) 82%, transparent), color-mix(in srgb, var(--panel-soft) 88%, transparent))}
  .weekly-plan-current-card h3,.weekly-plan-card h3{margin:.1rem 0}
  .weekly-plan-current-card .route-card-footer{margin-top:0}
  .weekly-plan-rest-panel{margin-top:1rem}
  .weekly-plan-grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))}
  .weekly-plan-card{display:grid;gap:.85rem}
</style>

<script>
  // @ts-nocheck
  import { formatReviewBasis, isUsableWeeklyPlan, readContinuitySnapshot, resolveReviewFocus, resolveWeeklyPlanTarget } from '../lib/learner-continuity.js';
  import { STORAGE_KEYS, firstIncompletePlanStep, readStoredJson, writeStoredJson } from '../lib/storage.js';

  const root = document.querySelector('.weekly-plan-panel');
  const lessons = JSON.parse(root?.dataset.lessons || '[]');
  const exercises = JSON.parse(root?.dataset.exercises || '[]');
  const base = root?.dataset.base || '/soroban-dojo/';
  const continuity = readContinuitySnapshot(localStorage);
  const completedLessons = continuity.completedLessons;
  const exerciseStates = continuity.exerciseStates;
  const reviewFocus = resolveReviewFocus(continuity.reviewProfile);
  const target = resolveWeeklyPlanTarget(continuity);

  const planByTarget = {
    foundations: {
      title: 'Foundations start week',
      copy: 'Begin with one-rod reading and one direct beginner check before you open broader drills or harder review paths.',
      lesson: 'lesson-l0-002',
      exercise: 'exercise-l0-003',
      worksheet: `${base}worksheets?preset=foundations-focus&submode=arithmetic-rhythm`,
    },
    beginner: {
      title: 'One-rod confidence week',
      copy: 'Connect one short addition lesson to a direct one-rod check and a matching focused sheet.',
      lesson: 'lesson-l1-002',
      exercise: 'exercise-l1-003',
      worksheet: `${base}worksheets?preset=one-rod-focus&submode=arithmetic-rhythm`,
    },
    arithmetic: {
      title: 'Arithmetic rhythm week',
      copy: 'Keep the total readable through mixed additions and subtractions before adding more speed.',
      lesson: 'lesson-l3-001',
      exercise: 'exercise-l3-001',
      exerciseSlug: 'l3/mixed-two-digit-sequence',
      worksheet: `${base}worksheets?preset=mixed-fluency&submode=arithmetic-rhythm`,
    },
    complements: {
      title: 'Complements repair week',
      copy: 'Return to five and ten complements until blocked moves become immediate again.',
      lesson: 'lesson-l2-002',
      exercise: 'exercise-l2-003',
      worksheet: `${base}worksheets?preset=complements&submode=complement-balance`,
    },
    multiplication: {
      title: 'Multiplication structure week',
      copy: 'Focus on place shifts and repeated table families before using broad mixed multiplication drills.',
      lesson: 'lesson-l4-005',
      exercise: 'exercise-l4-005',
      worksheet: `${base}worksheets?preset=multiplication-focus&submode=place-shifts`,
    },
    division: {
      title: 'Division quotient week',
      copy: 'Practice exact quotient building and fact-family verification before harder mixed division sheets.',
      lesson: 'lesson-l4-006',
      exercise: 'exercise-l4-007',
      worksheet: `${base}worksheets?preset=division-focus&submode=quotient-building`,
    },
    mental: {
      title: 'Mental stability week',
      copy: 'Use short anzan sequences and rhythm checks before increasing speed or complexity.',
      lesson: 'lesson-l5-001',
      exercise: 'exercise-l5-001',
      worksheet: `${base}worksheets?preset=anzan-focus&submode=anzan-recall`,
    },
  };

  const planId = target;
  const plan = planByTarget[target] || planByTarget.foundations;
  const lesson = lessons.find((entry) => entry.id === plan.lesson) || lessons[0];
  const exercise = exercises.find((entry) => entry.slug === plan.exerciseSlug)
    || exercises.find((entry) => entry.id === plan.exercise)
    || exercises[0];

  const writePlanState = (state) => writeStoredJson(localStorage, STORAGE_KEYS.weeklyStudyPlan, state);

  const currentPlanState = readStoredJson(localStorage, STORAGE_KEYS.weeklyStudyPlan, {});
  const matchesCurrentPlan = (state) => isUsableWeeklyPlan(state)
    && (state?.planId || state?.target) === planId
    && state?.continuityKey === continuity.continuityKey
    && state?.lesson?.id === lesson?.id
    && state?.exercise?.id === exercise?.id
    && state?.worksheet?.href === plan.worksheet;
  const stateMatchesPlan = matchesCurrentPlan(currentPlanState);
  const normalizedPlanState = stateMatchesPlan
    ? currentPlanState
    : {
        planId,
        target,
        continuityKey: continuity.continuityKey,
        title: plan.title,
        lesson: { id: lesson?.id || plan.lesson, done: completedLessons.includes(lesson?.id) },
        exercise: { id: exercise?.id || plan.exercise, done: exerciseStates[exercise?.id]?.status === 'got-it' },
        worksheet: { href: plan.worksheet, done: false },
      };
  const readPlanState = () => {
    const latest = readStoredJson(localStorage, STORAGE_KEYS.weeklyStudyPlan, {});
    return matchesCurrentPlan(latest) ? latest : normalizedPlanState;
  };

  document.getElementById('weekly-plan-title').textContent = plan.title;
  document.getElementById('weekly-plan-copy').textContent = reviewFocus || continuity.reviewProfile.historyIncomplete
    ? `${plan.copy} ${formatReviewBasis(continuity.reviewProfile)}`
    : plan.copy;

  const cards = [
    {
      eyebrow: 'Day 1-2',
      key: 'lesson',
      stepLabel: 'lesson',
      title: lesson?.title || 'Lesson review',
      copy: completedLessons.includes(lesson?.id) ? 'You already completed this lesson once. Re-read it quickly, then move straight into the exercise.' : 'Start with the concept explanation and worked example before drilling.',
      href: `${base}lessons/${lesson?.slug}`,
      label: 'Open lesson',
    },
    {
      eyebrow: 'Day 3-4',
      key: 'exercise',
      stepLabel: 'exercise',
      title: exercise?.title || 'Exercise review',
      copy: 'Attempt the exercise first, then use the hint or reveal only if the structure is still unclear.',
      href: `${base}exercises/${exercise?.slug}`,
      label: 'Open exercise',
    },
    {
      eyebrow: 'Day 5-7',
      key: 'worksheet',
      stepLabel: 'worksheet',
      title: 'Focused worksheet set',
      copy: 'Use a printable or on-screen sheet that matches the same weak area and submode.',
      href: plan.worksheet,
      label: 'Open worksheet',
    },
  ];

  const grid = document.getElementById('weekly-plan-grid');
  const currentMount = document.getElementById('weekly-plan-current');

  const renderToggleText = (card, done) => done ? `Mark ${card.stepLabel} pending` : `Mark ${card.stepLabel} done`;
  const renderStatusText = (done) => done ? 'Marked done for this week.' : 'Still active in this week\'s plan.';

  const appendText = (parent, tag, text, className = '') => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    node.textContent = text;
    parent.appendChild(node);
    return node;
  };

  const renderPlan = ({ focusStep = null, focusCompletion = false } = {}) => {
    const state = readPlanState();
    const activeStep = firstIncompletePlanStep(state);
    const currentIndex = activeStep ? cards.findIndex((card) => card.key === activeStep) : -1;
    currentMount.replaceChildren();
    grid.replaceChildren();

    if (currentIndex === -1) {
      const complete = document.createElement('article');
      complete.className = 'panel route-card weekly-plan-card weekly-plan-current-card';
      appendText(complete, 'p', 'All steps marked', 'eyebrow');
      const completeTitle = appendText(complete, 'h3', 'All planned steps are marked done');
      completeTitle.tabIndex = -1;
      appendText(complete, 'p', 'Use a daily drill for optional review, or mark any step pending below if you want to revisit it. These checklist marks are not verified completion evidence.', 'muted');
      const actions = document.createElement('div');
      actions.className = 'button-row button-row-compact route-card-footer';
      const dailyLink = document.createElement('a');
      dailyLink.className = 'button';
      dailyLink.href = `${base}daily-drills`;
      dailyLink.textContent = 'Open optional daily drill';
      actions.appendChild(dailyLink);
      complete.appendChild(actions);
      currentMount.appendChild(complete);
    }

    cards.forEach((card, index) => {
      const isCurrent = index === currentIndex;
      const done = Boolean(state[card.key]?.done);
      const article = document.createElement('article');
      article.className = isCurrent
        ? 'panel route-card weekly-plan-card weekly-plan-current-card'
        : 'subtle-panel weekly-plan-card';
      appendText(article, 'p', isCurrent ? 'Current step' : card.eyebrow, 'eyebrow');
      appendText(article, 'h3', card.title);
      appendText(article, 'p', card.copy, 'muted');

      const actions = document.createElement('div');
      actions.className = `button-row button-row-compact${isCurrent ? ' route-card-footer' : ''}`;
      const link = document.createElement('a');
      link.className = isCurrent ? 'button' : 'button button-secondary';
      link.href = card.href;
      link.textContent = card.label;
      const toggle = document.createElement('button');
      toggle.className = 'button button-secondary weekly-plan-toggle';
      toggle.type = 'button';
      toggle.dataset.step = card.key;
      toggle.textContent = renderToggleText(card, done);
      toggle.addEventListener('click', () => {
        const latest = readPlanState();
        latest[card.key] = { ...(latest[card.key] || {}), done: !latest[card.key]?.done };
        writePlanState(latest);
        const nextStep = firstIncompletePlanStep(latest);
        renderPlan({ focusStep: nextStep, focusCompletion: nextStep === null });
      });
      actions.append(link, toggle);
      article.appendChild(actions);
      appendText(article, 'p', renderStatusText(done), 'muted small weekly-plan-status');
      (isCurrent ? currentMount : grid).appendChild(article);
    });

    if (focusCompletion) currentMount.querySelector('h3')?.focus();
    else if (focusStep) root.querySelector(`.weekly-plan-toggle[data-step="${focusStep}"]`)?.focus();
  };

  renderPlan();
</script>
