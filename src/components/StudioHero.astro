---
interface StatItem {
  label: string;
  value: string;
}

interface ActionItem {
  href: string;
  label: string;
  secondary?: boolean;
  id?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  stats: StatItem[];
  actions?: ActionItem[];
  mistVar?: string;
}

const { eyebrow, title, summary, stats, actions = [], mistVar = '--studio-mist' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="studio-hero panel" style={`background-image:var(--hero-overlay), var(${mistVar})`}>
  <div class="studio-hero-brand">
    <div class="studio-hero-mark" aria-hidden="true">
      <img class="theme-decoration" src={`${base}graphics/sakura-mark.svg`} alt="" />
    </div>
    <div class="content-prose">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{summary}</p>
      {actions.length > 0 && (
        <div class="hero-actions">
          {actions.map((action, index) => (
            <a id={action.id} class={`button ${action.secondary || index > 0 ? 'button-secondary' : ''}`.trim()} href={action.href}>{action.label}</a>
          ))}
        </div>
      )}
    </div>
  </div>
  <div class="studio-hero-stats">
    {stats.map((stat) => (
      <article class="subtle-panel studio-hero-stat">
        <span>{stat.label}</span>
        <strong>{stat.value}</strong>
      </article>
    ))}
  </div>
</section>

<style>
  .studio-hero {
    display: grid;
    gap: 1rem;
    border: 1px solid color-mix(in srgb, var(--hero-border) 55%, transparent);
    box-shadow: 0 18px 48px color-mix(in srgb, var(--accent) 8%, transparent);
    background-size: cover;
    background-position: center bottom;
  }
  .studio-hero-brand { display:flex; gap:1rem; align-items:flex-start; }
  .studio-hero-mark { width:4.5rem; height:4.5rem; border-radius:1.5rem; background:color-mix(in srgb, var(--panel-raised) 80%, transparent); display:grid; place-items:center; box-shadow:0 12px 32px color-mix(in srgb, var(--accent) 12%, transparent); flex:0 0 auto; }
  .studio-hero-mark img { width:3.25rem; height:3.25rem; }
  .studio-hero-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.85rem; }
  .studio-hero-stat { display:grid; gap:.35rem; }
  .studio-hero-stat span { font-size:.75rem; text-transform:uppercase; letter-spacing:.06em; color:var(--accent); }
  @media (max-width: 900px) {
    .studio-hero-stats { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .studio-hero-mark { display:none; }
  }
</style>
