<div id="storage-compatibility-notice" class="storage-compatibility-notice" role="status" aria-live="polite" hidden></div>

<script>
  import { ensureStorageCompatibility } from '../lib/storage-migrations.js';

  const result = ensureStorageCompatibility(localStorage);
  document.documentElement.dataset.storageWritable = String(result.writable);
  const notice = document.getElementById('storage-compatibility-notice');
  const showNotice = (message: string) => {
    if (!notice) return;
    notice.textContent = message;
    notice.hidden = false;
  };
  if (result.future) {
    showNotice('Newer Soroban Dojo progress was found. Saved progress is protected and read-only in this older page. You can practice in this tab, but changes will not be saved.');
  } else if (!result.writable) {
    showNotice('Saved progress could not be validated. Existing records are protected and read-only. You can practice in this tab, but changes will not be saved.');
  }
  try {
    const resetNotice = sessionStorage.getItem('soroban-dojo:reset-notice');
    if (resetNotice) {
      sessionStorage.removeItem('soroban-dojo:reset-notice');
      showNotice(resetNotice);
    }
  } catch {}
  window.dispatchEvent(new CustomEvent('soroban:storage-ready', { detail: result }));
  let resetPending = false;
  const reloadForExternalReset = () => {
    if (resetPending) return;
    resetPending = true;
    try { sessionStorage.setItem('soroban-dojo:reset-notice', 'Progress was reset in another open Soroban Dojo tab.'); } catch {}
    window.location.reload();
  };
  window.addEventListener('storage', (event) => {
    if (event.key === 'soroban-dojo:reset-epoch') reloadForExternalReset();
  });
  if ('BroadcastChannel' in window) {
    const resetChannel = new BroadcastChannel('soroban-dojo:progress');
    resetChannel.addEventListener('message', (event) => {
      if (event.data?.type === 'reset') reloadForExternalReset();
    });
  }
</script>

<style>
  .storage-compatibility-notice {
    width: min(calc(100% - 2rem), 72rem);
    margin: 0.75rem auto 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--panel-raised);
    color: var(--ink);
    font-size: 0.9rem;
  }
</style>
