---
import { numberToKanji } from '../lib/japanese';
import { normalizeStepTimeline, numberToSorobanState, rodStateToDigit } from '../lib/soroban.js';

interface Props {
  value: number;
  label?: string;
  stepValues?: number[];
}

const { value, label = 'Soroban visual', stepValues = [] } = Astro.props;

const renderValue = (input: number) => numberToSorobanState(input).rods.map((state, index, rods) => ({
  key: `${input}-${index}`,
  digit: rodStateToDigit(state),
  position: rods.length - index,
  upperActive: state.upperActive,
  lowerActive: state.lowerActive,
}));

const stepSeries = normalizeStepTimeline(stepValues, value);
---

<section class="soroban-visual panel">
  <div class="section-head">
    <div>
      <p class="eyebrow">Reusable visual engine</p>
      <h2>{label}</h2>
    </div>
    <span class="badge">Value {value} · {numberToKanji(value)}</span>
  </div>
  <div class="soroban-board" role="img" aria-label={`${label}: value ${value}`}>
    {renderValue(value).map((rod) => (
      <div class="rod" aria-hidden="true">
        <div class:list={["bead", "upper", rod.upperActive && 'active']} />
        <div class="beam" />
        {Array.from({ length: 4 }, (_, index) => (
          <div class:list={["bead", "lower", index < rod.lowerActive && 'active']} />
        ))}
      </div>
    ))}
  </div>
  {stepSeries.length > 1 && (
    <div class="step-series">
      {stepSeries.map((stepValue, index) => (
        <div class="step-card">
          <p class="eyebrow">Step {index + 1}</p>
          <strong>{stepValue}</strong>
        </div>
      ))}
    </div>
  )}
</section>
