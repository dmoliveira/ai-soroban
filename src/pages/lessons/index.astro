---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudioHero from '../../components/StudioHero.astro';
import { LEVELS } from '../../lib/constants';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.id.localeCompare(b.data.id));
const firstLesson = lessons[0] ?? null;
const lessonGroups = LEVELS.map((level) => ({
  ...level,
  lessons: lessons.filter((lesson) => lesson.data.level === level.id),
})).filter((group) => group.lessons.length > 0);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Lessons | Soroban Dojo" description="Browse soroban lessons in a calmer level-by-level order, start with the best first lesson, and move into practice after each concept.">
  <StudioHero
    eyebrow="Lessons"
    title="Learn in order, then practice"
    summary="Need the full path from first beads through multiplication, division, worksheets, and mental practice? Open the curriculum map first, then move lesson by lesson."
    stats={[
      { label: 'Use this for', value: 'Core concept study' },
      { label: 'Best companion', value: 'Matching worksheet' },
      { label: 'Best next move', value: 'Practice after reading' },
    ]}
    actions={[
      ...(firstLesson ? [{ href: `${base}lessons/${firstLesson.slug}`, label: 'Open the first lesson' }] : []),
      { href: `${base}curriculum`, label: 'Open curriculum map', secondary: true },
    ]}
  />

  <section class="panel content-prose lessons-library-panel">
    <div class="section-head">
      <div>
        <p class="eyebrow">Lesson library</p>
        <h2>Browse by level, then by lesson</h2>
      </div>
      <p class="muted">Choose the current band first, then pick one lesson inside it so the next step stays obvious.</p>
    </div>
    <div class="card-grid lessons-level-grid">
      {lessonGroups.map((group) => (
        <article class="panel route-card lessons-level-card">
          <p class="eyebrow">{group.id}</p>
          <h3>{group.name}</h3>
          <p>{group.focus}</p>
          <ul class="list-clean compact-library">
            {group.lessons.map((lesson, index) => (
              <li class="library-card-item">
                <p class="eyebrow">{index === 0 ? 'Start here' : 'Then continue'}</p>
                <strong>{lesson.data.title}</strong>
                <div class="meta-row">
                  <span>{lesson.data.skill}</span>
                  <span>{lesson.data.estimatedMinutes} min</span>
                </div>
                <p>{lesson.data.summary}</p>
                <div class="route-card-footer">
                  <span class="muted small">Best next step: read, then practice once</span>
                  <a class="library-action-link" href={`${base}lessons/${lesson.slug}`} aria-label={`Open lesson: ${lesson.data.title}`}>Open lesson →</a>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <style>
    .lessons-level-card{background:linear-gradient(180deg, rgba(255,255,255,.82), rgba(248,242,233,.88))}
    .lessons-level-card h3{margin:.1rem 0}
    .lessons-level-grid{margin-bottom:0}
    .lessons-library-panel>.card-grid{margin-bottom:0}
  </style>
</BaseLayout>
