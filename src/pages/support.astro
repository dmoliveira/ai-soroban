---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Support | Soroban Dojo" description="Support Soroban Dojo through donations, feedback, and sharing so calmer soroban lessons, worksheets, and practice tools can keep improving.">
  <section class="support-studio-hero panel" style={`--support-mist:url('${base}graphics/worksheet-mist.svg')`}>
    <div class="support-studio-brand">
      <div class="support-studio-mark" aria-hidden="true"><img class="theme-decoration" src={`${base}graphics/sakura-mark.svg`} alt="" /></div>
      <div class="content-prose">
        <p class="eyebrow">Support the dojo</p>
        <h1>Help keep practical soroban lessons free</h1>
        <p>Your support funds more lessons, more exercises, stronger worksheet tooling, and calmer study tools for children and adults.</p>
      </div>
    </div>
    <div class="support-studio-stats">
      <article class="subtle-panel support-studio-stat"><span>What stays free</span><strong>Lessons, exercises, worksheets</strong></article>
      <article class="subtle-panel support-studio-stat"><span>What support funds</span><strong>New content + better tools</strong></article>
      <article class="subtle-panel support-studio-stat"><span>Other help</span><strong>Share or send feedback</strong></article>
    </div>
    <div class="hero-actions">
      <a class="button" href="https://buy.stripe.com/8x200i8bSgVe3Vl3g8bfO00" target="_blank" rel="noreferrer">Donate via Stripe</a>
      <a class="button button-secondary" href={`${base}releases`}>See recent updates</a>
    </div>
  </section>

  <section class="split-grid">
    <article class="panel content-prose route-card compact-card">
      <p class="eyebrow">What support makes possible</p>
      <h2>More calm tools, not more noise</h2>
      <ul>
        <li>New worksheets, drills, and attempt-first practice modes</li>
        <li>More refined explanations for children and adults</li>
        <li>Better browser-first tools that stay privacy-friendly</li>
      </ul>
    </article>
    <article class="panel content-prose route-card compact-card">
      <p class="eyebrow">Non-monetary support</p>
      <h2>You can help in other ways too</h2>
      <p>Share the dojo, send feedback on confusing spots, and keep pointing out where the learning flow can become clearer and calmer.</p>
      <div class="hero-actions">
        <a class="button button-secondary" href={`${base}about`}>Read the project direction</a>
        <a class="button button-secondary" href={`${base}releases`}>See what changed recently</a>
      </div>
    </article>
  </section>

  <section class="panel content-prose support-guide-panel">
    <div class="section-head">
      <div>
        <p class="eyebrow">Best ways to help</p>
        <h2>Pick the lightest useful contribution</h2>
      </div>
      <p class="muted">Money helps, but clarity helps too. The best support usually removes confusion for the next learner.</p>
    </div>
    <div class="card-grid">
      <article class="subtle-panel route-card compact-card support-guide-card">
        <p class="eyebrow">1. Share</p>
        <h3>Send one learner to the right starting page</h3>
        <p>Point new learners to Start here, placement, or the right level page instead of dropping them into the full site map.</p>
      </article>
      <article class="subtle-panel route-card compact-card support-guide-card">
        <p class="eyebrow">2. Report friction</p>
        <h3>Flag the page where the next step feels unclear</h3>
        <p>The most helpful feedback usually names the exact page, missing transition, or confusing choice overload.</p>
      </article>
      <article class="subtle-panel route-card compact-card support-guide-card">
        <p class="eyebrow">3. Fund deeper work</p>
        <h3>Support new lessons and tooling</h3>
        <p>Donations help add more worksheets, drills, and learner-friendly refinements without turning the site into a noisy product funnel.</p>
      </article>
    </div>
  </section>

  <style>
    .support-studio-hero{display:grid;gap:1rem;border:1px solid color-mix(in srgb, var(--hero-border) 55%, transparent);box-shadow:0 18px 48px color-mix(in srgb, var(--accent) 8%, transparent);background-image:var(--hero-overlay), var(--support-mist);background-size:cover;background-position:center bottom}
    .support-studio-brand{display:flex;gap:1rem;align-items:flex-start}.support-studio-mark{width:4.5rem;height:4.5rem;border-radius:1.5rem;background:color-mix(in srgb, var(--panel-raised) 80%, transparent);display:grid;place-items:center;box-shadow:0 12px 32px color-mix(in srgb, var(--accent) 12%, transparent);flex:0 0 auto}.support-studio-mark img{width:3.25rem;height:3.25rem}.support-studio-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.85rem}.support-studio-stat{display:grid;gap:.35rem}.support-studio-stat span{font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--accent)}@media (max-width:900px){.support-studio-stats{grid-template-columns:1fr}}
    .support-guide-panel .card-grid{margin-bottom:0}.support-guide-card{background:linear-gradient(180deg, color-mix(in srgb, var(--panel-raised) 82%, transparent), color-mix(in srgb, var(--panel-soft) 88%, transparent))}.support-guide-card h3{margin:.1rem 0}
  </style>
</BaseLayout>
