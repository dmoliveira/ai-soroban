---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudioHero from '../../components/StudioHero.astro';

const exercises = (await getCollection('exercises')).sort((a, b) => a.data.id.localeCompare(b.data.id));
const firstExercise = exercises[0] ?? null;
const levelOrder = ['L0', 'L1', 'L2', 'L3', 'L4', 'L5'];
const groupedExercises = levelOrder.map((level) => ({ level, items: exercises.filter((entry) => entry.data.level === level) })).filter((group) => group.items.length);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Exercises | Soroban Dojo" description="Move from soroban lessons into one matching exercise at a time with a calmer first-exercise recommendation and level-by-level practice browse.">
  <StudioHero
    eyebrow="Exercise library"
    title="Attempt first. Then compare."
    summary="Use these like a skill ladder: concept checks first, then rhythm drills, then challenge-style review inside practice and worksheets."
    stats={[
      { label: 'Best use', value: 'Single focused checks' },
      { label: 'Best follow-up', value: 'Practice or worksheet' },
      { label: 'Tone', value: 'Attempt first' },
    ]}
    actions={[
      ...(firstExercise ? [{ href: `${base}exercises/${firstExercise.id}`, label: 'Open the first exercise' }] : []),
      { href: `${base}lessons`, label: 'Back to lessons', secondary: true },
    ]}
  />

  <section class="panel exercises-library-panel">
    <div class="section-head">
      <div>
        <p class="eyebrow">Exercise library</p>
        <h2>Browse by level</h2>
      </div>
      <p class="muted">Pick the current level, attempt one clean check, then return to broader practice only if you still need repetition.</p>
    </div>
    <div class="content-prose">
      {groupedExercises.map((group) => (
        <section>
          <h2>{group.level}</h2>
          <ul class="list-clean compact-library">
            {group.items.map((exercise) => (
              <li class="library-card-item">
                <strong>{exercise.data.title}</strong>
                <div class="meta-row">
                  <span>{exercise.data.level}</span>
                  <span>{exercise.data.skill}</span>
                  <span>Difficulty {exercise.data.difficulty}</span>
                </div>
                <p>{exercise.data.hint}</p>
                <div class="route-card-footer">
                  <span class="muted small">Best next step: use this after one lesson read-through</span>
                  <a class="library-action-link" href={`${base}exercises/${exercise.id}`} aria-label={`Open exercise: ${exercise.data.title}`}>Open exercise →</a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

</BaseLayout>
