---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SorobanVisualizer from '../../components/SorobanVisualizer.astro';
import { numberToKanji } from '../../lib/japanese';

export async function getStaticPaths() {
  const exercises = await getCollection('exercises');
  return exercises.map((exercise) => ({ params: { slug: exercise.id }, props: { exercise } }));
}

const { exercise } = Astro.props;
const { Content } = await render(exercise);
const lessons = await getCollection('lessons');
const relatedLesson = lessons.find((lesson) => lesson.data.relatedExercises.includes(exercise.data.id));
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const focusedPracticeHref = `${base}practice?level=${exercise.data.level}&skill=${encodeURIComponent(exercise.data.skill)}&start=1`;
const bestFor = exercise.data.type === 'visual-check'
  ? 'Best for bead recognition and calm reading before moving into full arithmetic practice.'
  : exercise.data.type === 'setup'
    ? 'Best for controlled placement and accurate soroban setup before longer drills.'
    : exercise.data.type === 'addition' || exercise.data.type === 'subtraction'
      ? 'Best for short accuracy checks before moving into longer worksheet or sequence work.'
      : 'Best for focused single-question practice and careful method review.';
---

<BaseLayout title={`${exercise.data.title} | Soroban Dojo`}>
  <article
    class="panel content-prose exercise-page-panel"
    data-exercise={JSON.stringify({
      answer: exercise.data.answer,
      evaluation: exercise.data.evaluation ?? { kind: 'numeric', accepted: [exercise.data.expectedValue] },
      hint: exercise.data.hint,
      explanation: exercise.data.explanation,
      id: exercise.data.id,
      level: exercise.data.level,
      skill: exercise.data.skill,
    })}
  >
    <p class="eyebrow">Exercise · {exercise.data.level}</p>
    <h1>{exercise.data.title}</h1>
    <div class="meta-row detail-meta-row">
      <span>{exercise.data.skill}</span>
      <span>{exercise.data.type}</span>
      <span>{exercise.data.estimatedMinutes} min</span>
      {exercise.data.visualValue !== undefined && <span>数 {numberToKanji(exercise.data.visualValue)}</span>}
      {exercise.data.worksheetProfile && <span>{exercise.data.worksheetProfile.label ?? `${exercise.data.worksheetProfile.digitRange} digits · ${exercise.data.worksheetProfile.operationRange} ops · ${exercise.data.worksheetProfile.operatorMode}`}</span>}
    </div>
    <div class="exercise-utility-row detail-utility-row">
      <a class="text-link" href={`${base}exercises`}>All exercises</a>
      <a class="text-link" href={`${base}levels/${exercise.data.level.toLowerCase()}`}>This level</a>
      <a class="text-link" href={focusedPracticeHref}>Practice</a>
    </div>
    <section class="exercise-facts-grid detail-facts-grid">
      <article class="stat-card stat-card-soft"><span>{exercise.data.level}</span><small>Level</small></article>
      <article class="stat-card stat-card-soft"><span>{exercise.data.skill}</span><small>Skill</small></article>
      <article class="stat-card stat-card-soft"><span>{exercise.data.type}</span><small>Type</small></article>
      <article class="stat-card stat-card-soft"><span>{exercise.data.estimatedMinutes}m</span><small>Time</small></article>
    </section>
    <div class="subtle-panel exercise-best-for-panel">
      <strong>Best for</strong>
      <p class="muted">{bestFor}</p>
    </div>
    <div class="exercise-intro-panel subtle-panel">
      <p><strong>Practice rule:</strong> try this before opening the hint or answer.</p>
      {exercise.data.worksheetDrill && (
        <pre class="worksheet-ledger">{exercise.data.worksheetDrill.map((term, index) => index === 0 ? `${term.value}` : `${term.operator} ${term.value}`).join('\n')}</pre>
      )}
      <Content />
    </div>
    {exercise.data.visualValue !== undefined && (
      <SorobanVisualizer value={exercise.data.visualValue} stepValues={exercise.data.stepValues} label={`Visual support for ${exercise.data.title}`} />
    )}

    <section class="panel exercise-interaction-panel">
      <p class="eyebrow">Attempt first</p>
      <div class="question-flow-note lesson-flow-steps">
        <span class="review-chip">1. Solve first</span>
        <span class="review-chip">2. Write your response</span>
        <span class="review-chip">3. Verify or reveal</span>
      </div>
      <label class="stack-sm answer-stack">
        <span>Your response</span>
        <input id="exercise-response" class="input" type="text" inputmode={exercise.data.expectedValue !== undefined ? 'numeric' : 'text'} placeholder={exercise.data.expectedValue !== undefined ? 'Write your number before checking' : 'Write your response before checking'} />
      </label>
      <div class="button-row button-row-compact exercise-primary-actions">
        <button class="button" id="verify-exercise">Verify response</button>
      </div>
      <div class="reward-state-card exercise-checkpoint-card">
        <div class="reward-state-head"><span class="reward-state-mark">✦</span><strong id="exercise-state-status">Ready to attempt</strong></div>
        <div class="exercise-state-strip">
          <div class="exercise-state-card"><small>Response</small><span id="exercise-state-response">—</span></div>
        <div class="exercise-state-card"><small>Saved state</small><span id="exercise-state-memory">This attempt stays on this device.</span></div>
        </div>
      </div>
      <div class="button-row button-row-compact exercise-support-actions">
        <button class="button button-secondary" id="hint-exercise">Need a hint?</button>
        <button class="button button-secondary" id="reveal-answer">Reveal answer</button>
        <button class="button button-secondary" id="reveal-method">Reveal method</button>
        <button class="button button-secondary" id="reset-exercise">Try again</button>
      </div>
      <div id="exercise-feedback" class="reveal-panel" hidden role="status" aria-live="polite"></div>
      <div id="exercise-method" class="reveal-panel" hidden></div>
    </section>

    <section class="panel lesson-next-panel">
      <p class="eyebrow">Next step</p>
      <h2>Continue with guided practice</h2>
      <div class="button-row">
        <a class="button" href={focusedPracticeHref}>Practice this level</a>
        <a class="button button-secondary" href={`${base}worksheets`}>Open worksheet</a>
        {relatedLesson && <a class="button button-secondary" href={`${base}lessons/${relatedLesson.id}`}>Review lesson</a>}
      </div>
      <p class="muted">Move straight into guided practice, or open worksheets for a denser set of drills around this same skill.</p>
      {relatedLesson && (
        <div class="subtle-panel exercise-related-lesson route-card">
          <strong>Related lesson</strong>
          <p class="muted">{relatedLesson.data.title}</p>
          <div class="route-card-footer">
            <span class="muted small">Best next step: review the concept, then retry</span>
            <a class="text-link" href={`${base}lessons/${relatedLesson.id}`}>Open lesson →</a>
          </div>
        </div>
      )}
    </section>
  </article>

  <script>
    // @ts-nocheck
    import { evaluateResponse } from '../../lib/evaluation.js';
    import { appendEvidenceEvent, claimMasteryItem, createAttemptEvidence, masteryClaimOwnedBy, normalizeMasterySeenIndex, summarizeAttemptEvidence, upsertAttemptEvidence } from '../../lib/mastery.js';
    import { STORAGE_KEYS, readStoredArray, readStoredJson, readStoredRecord, writeStoredJson } from '../../lib/storage.js';
    import { ensureStorageCompatibility } from '../../lib/storage-migrations.js';

    ensureStorageCompatibility(localStorage);

    const exerciseRoot = document.querySelector('.exercise-page-panel');
    const exerciseData = JSON.parse(exerciseRoot?.dataset.exercise || '{}');
    const {
      answer,
      evaluation,
      hint,
      explanation,
      id: exerciseId,
      level: exerciseLevel,
      skill: exerciseSkill,
    } = exerciseData;
    const responseInput = document.getElementById('exercise-response');
    const feedback = document.getElementById('exercise-feedback');
    const method = document.getElementById('exercise-method');
    const responseState = document.getElementById('exercise-state-response');
    const statusState = document.getElementById('exercise-state-status');
    const memoryState = document.getElementById('exercise-state-memory');
    const exerciseStateKey = STORAGE_KEYS.exerciseStates;
    const audioWindow = typeof window !== 'undefined' ? /** @type {any} */ (window) : null;
    const AudioContextCtor = audioWindow
      ? audioWindow.AudioContext || (audioWindow).webkitAudioContext || null
      : null;
    const audioCtx = AudioContextCtor ? new AudioContextCtor() : null;

    const playTone = (type) => {
      if (!audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      const start = audioCtx.currentTime;
      const freqA = type === 'success' ? 660 : 280;
      const freqB = type === 'success' ? 880 : 220;
      osc.frequency.setValueAtTime(freqA, start);
      osc.frequency.linearRampToValueAtTime(freqB, start + 0.16);
      gain.gain.setValueAtTime(0.0001, start);
      gain.gain.linearRampToValueAtTime(0.028, start + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.2);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(start + 0.22);
    };

    const readExerciseStates = () => readStoredRecord(localStorage, exerciseStateKey);
    const writeExerciseStates = (state) => writeStoredJson(localStorage, exerciseStateKey, state);
    const readSeenItems = () => normalizeMasterySeenIndex(readStoredJson(localStorage, STORAGE_KEYS.masterySeenItems, {}));
    const hasPriorAnswerExposure = () => readSeenItems().claims.some((claim) => claim.itemId === exerciseId)
      || readStoredArray(localStorage, STORAGE_KEYS.masteryEvidence)
        .some((attempt) => attempt?.itemId === exerciseId && Array.isArray(attempt.events) && attempt.events.length > 0);
    let attemptSequence = 0;
    const newAttempt = () => {
      attemptSequence += 1;
      return createAttemptEvidence({
        attemptId: `exercise:${exerciseId}:${Date.now().toString(36)}:${attemptSequence}`,
        source: 'exercise',
        itemId: exerciseId,
        skill: exerciseSkill,
        level: exerciseLevel,
        rule: { id: exerciseId, version: 1 },
        eligibility: hasPriorAnswerExposure() ? 'activity-only' : 'prospective',
      });
    };
    let attemptEvidence = newAttempt();
    const persistEvidence = () => {
      const claim = claimMasteryItem(readSeenItems(), {
        itemId: attemptEvidence.itemId,
        attemptId: attemptEvidence.attemptId,
        firstSeenAt: attemptEvidence.events[0]?.at || attemptEvidence.startedAt,
      });
      const claimSaved = !claim.changed || writeStoredJson(localStorage, STORAGE_KEYS.masterySeenItems, claim.index);
      const claimOwned = claim.eligible
        && claimSaved
        && masteryClaimOwnedBy(readSeenItems(), attemptEvidence.itemId, attemptEvidence.attemptId);
      if (!claimOwned) attemptEvidence = { ...attemptEvidence, eligibility: 'activity-only' };
      let ledger = upsertAttemptEvidence(readStoredArray(localStorage, STORAGE_KEYS.masteryEvidence), attemptEvidence);
      attemptEvidence = ledger.find((attempt) => attempt.attemptId === attemptEvidence.attemptId) || attemptEvidence;
      let evidenceSaved = writeStoredJson(localStorage, STORAGE_KEYS.masteryEvidence, ledger);
      if (!evidenceSaved) attemptEvidence = { ...attemptEvidence, eligibility: 'activity-only' };
      const ownershipStable = attemptEvidence.eligibility !== 'prospective'
        || masteryClaimOwnedBy(readSeenItems(), attemptEvidence.itemId, attemptEvidence.attemptId);
      if (evidenceSaved && !ownershipStable) {
        attemptEvidence = { ...attemptEvidence, eligibility: 'activity-only' };
        ledger = upsertAttemptEvidence(readStoredArray(localStorage, STORAGE_KEYS.masteryEvidence), attemptEvidence);
        attemptEvidence = ledger.find((attempt) => attempt.attemptId === attemptEvidence.attemptId) || attemptEvidence;
        evidenceSaved = writeStoredJson(localStorage, STORAGE_KEYS.masteryEvidence, ledger);
      }
      return claimSaved && evidenceSaved;
    };
    const recordEvidence = (event) => {
      attemptEvidence = appendEvidenceEvent(attemptEvidence, event);
      const saved = persistEvidence();
      return { summary: summarizeAttemptEvidence(attemptEvidence), saved };
    };

    const applyWriteCellShortcut = (event) => {
      const input = event.currentTarget;
      if (!(input instanceof HTMLInputElement) || event.metaKey || event.ctrlKey || event.altKey) return false;
      if (event.key === '*' || event.code === 'NumpadMultiply') {
        event.preventDefault();
        input.value = '';
        return true;
      }
      if (event.key === '-' || event.code === 'NumpadSubtract') {
        event.preventDefault();
        input.value = input.value.slice(0, -1);
        return true;
      }
      return false;
    };

    document.getElementById('verify-exercise')?.addEventListener('click', () => {
      const value = responseInput.value.trim();
      if (!value) {
        feedback.hidden = false;
        feedback.textContent = 'Write your response first, or choose to reveal the answer or method.';
        responseState.textContent = 'Empty';
        statusState.textContent = 'Waiting for an attempt';
        if (memoryState) memoryState.textContent = 'Write something first.';
        return;
      }
      const evaluated = evaluateResponse(evaluation, value);
      const correct = evaluated.valid && evaluated.correct;
      const evidence = recordEvidence({ kind: 'submit', value, correct });
      feedback.hidden = false;
      playTone(correct ? 'success' : 'error');
      feedback.textContent = correct
        ? 'Correct. Your response matches the answer.'
        : evaluation?.kind === 'numeric'
          ? 'Not correct yet. Revise your number, ask for a hint, or reveal the answer.'
          : 'Not correct yet. Revise your wording, ask for a hint, or reveal the answer.';
      responseState.textContent = value;
      statusState.textContent = correct ? 'Correct response' : 'Try one revision';
      const state = readExerciseStates();
      state[exerciseId] = {
        status: correct ? 'got-it' : 'needs-review',
        level: exerciseLevel,
        skill: exerciseSkill,
        sessionId: `exercise:${exerciseLevel}:${exerciseSkill}`,
        updatedAt: new Date().toISOString(),
      };
      const stateSaved = writeExerciseStates(state);
      const saved = evidence.saved && stateSaved;
      const classification = !saved
        ? 'Not saved; this result is available only in the current tab.'
        : correct && evidence.summary.qualified && evidence.summary.firstCheckCorrect
          ? 'Saved as unassisted first-check evidence on this device.'
          : correct && evidence.summary.qualified
            ? 'Saved as a first-check miss with a later correction.'
            : correct
              ? 'Saved as assisted or repeated activity without new first-check credit.'
              : evidence.summary.qualified
                ? 'Saved as an unassisted first-check miss for review.'
                : 'Saved as activity without new first-check credit.';
      feedback.textContent += saved
        ? ` ${classification}`
        : ' This result remains available in this tab, but browser storage did not save it to Progress.';
      if (memoryState) memoryState.textContent = classification;
    });

    document.getElementById('hint-exercise')?.addEventListener('click', () => {
      const { saved } = recordEvidence({ kind: 'hint' });
      feedback.hidden = false;
      feedback.textContent = `Hint: ${hint}${saved ? '' : ' This hint use could not be saved to Progress.'}`;
      statusState.textContent = 'Hint shown';
      if (memoryState) memoryState.textContent = 'Use the hint, then try one revision.';
    });

    document.getElementById('reveal-answer')?.addEventListener('click', () => {
      const { saved } = recordEvidence({ kind: 'reveal-final' });
      feedback.hidden = false;
      playTone('success');
      feedback.textContent = `Answer: ${answer}${saved ? '' : ' This reveal could not be saved to Progress.'}`;
      statusState.textContent = 'Answer shown';
      if (memoryState) memoryState.textContent = 'The answer is visible now.';
    });

    document.getElementById('reveal-method')?.addEventListener('click', () => {
      const { saved } = recordEvidence({ kind: 'reveal-steps' });
      feedback.hidden = false;
      feedback.textContent = saved ? 'Method opened for review.' : 'Method opened, but this reveal could not be saved to Progress.';
      method.hidden = false;
      method.textContent = explanation;
      statusState.textContent = 'Method shown';
      if (memoryState) memoryState.textContent = 'Method is open for review.';
    });
    document.getElementById('reset-exercise')?.addEventListener('click', () => {
      responseInput.value = '';
      feedback.hidden = true;
      feedback.textContent = '';
      method.hidden = true;
      method.textContent = '';
      responseState.textContent = '—';
      statusState.textContent = 'Ready to attempt';
      if (memoryState) memoryState.textContent = 'This attempt stays on this device.';
      attemptEvidence = newAttempt();
      responseInput.focus();
    });
    responseInput?.addEventListener('keydown', (event) => {
      if (applyWriteCellShortcut(event)) return;
      if (event.key !== 'Enter') return;
      event.preventDefault();
      document.getElementById('verify-exercise')?.click();
    });
  </script>
</BaseLayout>

<style>
  .exercise-checkpoint-card { gap: 0.75rem; }
  .exercise-state-strip { display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:0.65rem; }
  .exercise-state-card { display:grid; gap:0.18rem; padding:0.7rem 0.8rem; border-radius:14px; background:color-mix(in srgb, var(--panel-raised) 50%, transparent); border:1px solid color-mix(in srgb, var(--line) 90%, transparent); }
  .exercise-state-card small { color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .exercise-support-actions { margin-top: 0.2rem; }
  @media (max-width: 860px) {
    .exercise-state-strip { grid-template-columns: 1fr; }
    .exercise-support-actions { gap: 0.5rem; }
  }
  .worksheet-ledger {
    margin: 1rem 0;
    padding: 0.9rem 1rem;
    border: 1px dashed color-mix(in srgb, var(--border) 78%, var(--panel-raised) 22%);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--panel-raised) 86%, var(--surface) 14%);
    font: 600 1.05rem/1.7 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    white-space: pre-wrap;
  }
</style>
