---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioHero from '../components/StudioHero.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Privacy | Soroban Dojo" description="Learn what Soroban Dojo stores locally in your browser, what it does not track, and how to clear your study progress on this device.">
  <StudioHero
    eyebrow="Privacy"
    title="Your progress stays in your browser"
    summary="Soroban Dojo keeps learning records local-first by default. No account, hidden analytics, or remote progress service is required."
    stats={[
      { label: 'Accounts', value: 'Not required' },
      { label: 'Analytics', value: 'No hidden tracking' },
      { label: 'Control', value: 'You can clear local progress' },
    ]}
    actions={[
      { href: `${base}progress`, label: 'Open progress controls' },
      { href: `${base}start-here`, label: 'Back to Start here', secondary: true },
    ]}
  />

  <section class="split-grid">
    <article class="panel content-prose route-card compact-card">
      <p class="eyebrow">What is stored</p>
      <h2>Only the study state you create</h2>
      <ul>
        <li>An explicitly selected children/adults route, lesson and exercise state, placement answers and starting point, and weekly-plan state</li>
        <li>Practice, timer, worksheet, and mini-game history</li>
        <li>Prospective first-check evidence, including hints, reveals, recovery use, and which attempt first exposed an item</li>
        <li>Boss progress, badges, certificates, and whether a clear was playable, offline, or legacy</li>
        <li>One display theme: Washi, Sakura, or Sumi</li>
      </ul>
    </article>
    <article class="panel content-prose route-card compact-card">
      <p class="eyebrow">What is not required</p>
      <h2>No account or signup pressure</h2>
      <p>You can use the dojo without creating an account. The design goal is calm, local-first study rather than account collection or behavioral tracking.</p>
      <p>Context-aware next actions are calculated on this device from the learning records listed here. Viewing one does not create or rewrite progress, and an exact saved-session resume ID stays inside the local Dojo link.</p>
    </article>
  </section>

  <section class="panel content-prose route-card compact-card">
    <p class="eyebrow">Compatibility boundary</p>
    <h2>Older activity stays visible without becoming verified mastery</h2>
    <p>First-check evidence is prospective from 0.4 onward. Earlier activity can remain visible for continuity, but Soroban Dojo does not upgrade it into verified mastery because those records do not contain enough attempt or assistance history.</p>
    <p>If a 0.4 versioned evidence, score, or provenance record cannot be validated, or the schema marker names a newer version, the compatibility layer disables learning-state writes instead of normalizing and overwriting those unknown records. Other malformed local records use safe read-time fallbacks. Compatibility updates are additive, and the saved theme remains separate.</p>
  </section>

  <section class="panel content-prose route-card compact-card">
    <p class="eyebrow">Reset control</p>
    <h2>Clearing progress is local to this browser</h2>
    <p>You can clear only the selected learner route, or only the placement starting point and answers, without erasing other progress. If you reset all progress, Soroban Dojo clears every learning and reward record stored on this device, including route, placement, weekly-plan, game, worksheet, practice, and boss data. Other open Dojo tabs are asked to reload; if the browser cannot notify them, the reset message tells you to reload those tabs manually. Your selected theme and unrelated browser data remain untouched. If that preference is missing or unavailable, the site safely uses Washi.</p>
    <div class="route-card-footer">
      <span class="muted small">Best next step: use Progress when you want to review or clear local study data.</span>
      <a class="button button-secondary" href={`${base}progress`}>Open progress controls</a>
    </div>
  </section>
</BaseLayout>
