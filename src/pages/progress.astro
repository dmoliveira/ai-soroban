---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioHero from '../components/StudioHero.astro';
import ProgressSummary from '../components/ProgressSummary.astro';
import BossBadgeSummary from '../components/BossBadgeSummary.astro';
import CertificateSummary from '../components/CertificateSummary.astro';

const lessons = (await getCollection('lessons')).map((entry) => ({ id: entry.data.id, title: entry.data.title, slug: entry.id, skill: entry.data.skill, level: entry.data.level }));
const exercises = (await getCollection('exercises')).map((entry) => ({ id: entry.data.id, title: entry.data.title, slug: entry.id, skill: entry.data.skill, level: entry.data.level }));
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Progress | Soroban Dojo">
  <StudioHero
    eyebrow="Progress studio · 歩み"
    title="See the next move before everything else"
    summary="Choose the next step first, then review the rest of your progress."
    stats={[
      { label: 'Best use', value: 'Choose the next action' },
      { label: 'Best follow-up', value: 'Continue this week' },
      { label: 'Signals', value: 'Review + milestones' },
    ]}
    actions={[
      { href: `${base}practice`, label: 'Continue practice' },
      { href: `${base}study-plan`, label: 'Open the study plan', secondary: true },
      { href: `${base}worksheets`, label: 'Generate a worksheet', secondary: true },
    ]}
    mistVar="--progress-mist"
  />
  <ProgressSummary lessons={lessons} exercises={exercises} />
  <section class="split-grid progress-milestone-grid">
    <BossBadgeSummary />
    <CertificateSummary />
  </section>

  <style>
    @media (max-width: 900px){
      .studio-hero{gap:.75rem}
      .studio-hero .content-prose p:last-child{margin-bottom:0}
      .studio-hero-stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}
      .studio-hero-stat:last-child{grid-column:1/-1}
      .studio-hero .hero-actions{gap:.5rem}
    }
  </style>
</BaseLayout>
